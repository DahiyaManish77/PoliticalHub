@model PoliticalLeaderPortal.Areas.Admin.ViewModels.Poll.PollResultVM
@{
    ViewBag.Title = "Poll Results";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h3 class="mb-1">@Model.Title</h3><div class="text-muted">@Model.Question</div></div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("ExportCsv", new { id = Model.PollId })" class="btn btn-outline-success">Export CSV</a>
            <a href="@Url.Action("QrCode", new { id = Model.PollId })" class="btn btn-outline-primary">Download QR</a>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Back</a>
        </div>
    </div>
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div><strong>Total Votes:</strong> @Model.TotalVotes <span class="ms-3">Public URL: <code id="pollPublicUrl">@Model.PublicUrl</code></span></div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary js-copy-poll">Copy URL</button>
                    <a class="btn btn-sm btn-primary" target="_blank" rel="noopener" href="https://www.facebook.com/sharer/sharer.php?u=@Uri.EscapeDataString(Model.PublicUrl)">Facebook</a>
                    <a class="btn btn-sm btn-dark" target="_blank" rel="noopener" href="https://twitter.com/intent/tweet?url=@Uri.EscapeDataString(Model.PublicUrl)&text=@Uri.EscapeDataString(Model.Title)">X</a>
                    <a class="btn btn-sm btn-success" target="_blank" rel="noopener" href="https://wa.me/?text=@Uri.EscapeDataString(Model.Title + " " + Model.PublicUrl)">WhatsApp</a>
                    <a class="btn btn-sm btn-info" target="_blank" rel="noopener" href="https://www.linkedin.com/sharing/share-offsite/?url=@Uri.EscapeDataString(Model.PublicUrl)">LinkedIn</a>
                    <a class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener" href="https://t.me/share/url?url=@Uri.EscapeDataString(Model.PublicUrl)&text=@Uri.EscapeDataString(Model.Title)">Telegram</a>
                    <button type="button" class="btn btn-sm btn-outline-danger js-instagram-poll">Instagram</button>
                    <button type="button" class="btn btn-sm btn-outline-dark js-native-share">More</button>
                </div>
            </div>
            <div class="form-text mt-2">Instagram does not provide a web URL-share endpoint; its button copies the poll URL and opens Instagram.</div>
            <div class="mt-3 d-flex align-items-center gap-3">
                <img src="@Url.Action("QrCode", new { id = Model.PollId })" width="112" height="112" alt="QR code for @Model.Title" class="border rounded p-1 bg-white" />
                <small class="text-muted">Scan to open this poll directly on a phone.</small>
            </div>
        </div>
    </div>
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-bold">Option Results</div>
        <div class="card-body">
            @foreach (var option in Model.Options)
            {
                <div class="mb-3">
                    <div class="d-flex justify-content-between"><strong>@option.OptionText</strong><span>@option.VoteCount (@option.VotePercent%)</span></div>
                    <div class="progress"><div class="progress-bar" style="width:@option.VotePercent%"></div></div>
                </div>
            }
        </div>
    </div>
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white fw-bold">Recent Votes</div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>Date</th><th>Option</th><th>Name</th><th>Mobile</th><th>Area</th><th>Source</th></tr></thead>
                <tbody>
                    @foreach (var vote in Model.Votes)
                    {
                        <tr><td>@vote.SubmittedDate.ToString("dd MMM yyyy HH:mm")</td><td>@vote.OptionText</td><td>@vote.RespondentName</td><td>@vote.MobileNo</td><td>@vote.AreaName</td><td>@vote.Source</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        (function () {
            var url = @Html.Raw(HttpUtility.JavaScriptStringEncode(Model.PublicUrl, true));
            var title = @Html.Raw(HttpUtility.JavaScriptStringEncode(Model.Title, true));
            function copyUrl() {
                if (navigator.clipboard) return navigator.clipboard.writeText(url);
                var input = document.createElement('input'); input.value = url; document.body.appendChild(input);
                input.select(); document.execCommand('copy'); input.remove(); return Promise.resolve();
            }
            document.querySelector('.js-copy-poll').addEventListener('click', function () { copyUrl().then(function () { alert('Poll URL copied.'); }); });
            document.querySelector('.js-instagram-poll').addEventListener('click', function () { copyUrl().then(function () { window.open('https://www.instagram.com/', '_blank', 'noopener'); }); });
            document.querySelector('.js-native-share').addEventListener('click', function () {
                if (navigator.share) { navigator.share({ title: title, text: title, url: url }); }
                else { copyUrl().then(function () { alert('Poll URL copied.'); }); }
            });
        })();
    </script>
}
