@model IEnumerable<PoliticalLeaderPortal.Areas.Admin.ViewModels.Poll.PollListVM>
@{
    ViewBag.Title = "Poll Management";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Poll Management</h4>
            <div class="d-flex gap-2">
                <a href="@Url.Action("Index", "PollCategory")" class="btn btn-light btn-sm">Categories</a>
                <a href="@Url.Action("Create")" class="btn btn-light btn-sm"><i class="fa fa-plus"></i> Create Poll</a>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Poll</th><th>Category</th><th>Status</th><th>Dates</th><th>Votes</th><th style="width:260px">Action</th></tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.Title</strong><div class="text-muted small">@item.Question</div></td>
                                <td>@item.CategoryName</td>
                                <td><span class="badge text-bg-light">@item.Status</span></td>
                                <td class="small">@item.StartDate.GetValueOrDefault().ToString("dd MMM yyyy") - @(item.EndDate.HasValue ? item.EndDate.Value.ToString("dd MMM yyyy") : "Open")</td>
                                <td>@item.TotalVotes</td>
                                <td>
                                    <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Edit", new { id = item.PollId })">Edit</a>
                                    <a class="btn btn-sm btn-outline-success" href="@Url.Action("Results", new { id = item.PollId })">Results</a>
                                    <button class="btn btn-sm btn-outline-info js-poll-action" data-url="@Url.Action("Publish", new { id = item.PollId })">Publish</button>
                                    <button class="btn btn-sm btn-outline-danger js-poll-action" data-url="@Url.Action("Delete", new { id = item.PollId })">Delete</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No polls found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/custom/poll-admin.js?v=20260724-1"></script>
}
