@model IEnumerable<PoliticalLeaderPortal.Areas.Admin.ViewModels.Poll.PollCategoryVM>
@{
    ViewBag.Title = "Poll Categories";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int sr = 1;
}

<div class="container-fluid">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Poll Categories</h4>
            <a href="@Url.Action("Create")" class="btn btn-light btn-sm"><i class="fa fa-plus"></i> Add Category</a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width:70px">#</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th style="width:100px">Order</th>
                            <th style="width:110px">Status</th>
                            <th style="width:150px">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@(sr++)</td>
                                    <td>@item.CategoryName</td>
                                    <td>@item.CategoryDescription</td>
                                    <td>@item.DisplayOrder</td>
                                    <td><span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">@(item.IsActive ? "Active" : "Inactive")</span></td>
                                    <td>
                                        <a href="@Url.Action("Edit", new { id = item.PollCategoryId })" class="btn btn-warning btn-sm"><i class="fa fa-edit"></i></a>
                                        <button type="button" class="btn btn-danger btn-sm js-poll-delete" data-url="@Url.Action("Delete", new { id = item.PollCategoryId })"><i class="fa fa-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">No poll categories found.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/custom/poll-admin.js?v=20260724-1"></script>
}
