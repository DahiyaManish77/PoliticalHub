@model PoliticalLeaderPortal.Areas.Admin.ViewModels.Poll.PollCategoryVM

<div class="container-fluid">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.PollCategoryId)
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0">@ViewBag.Title</h4>
                <a href="@Url.Action("Index")" class="btn btn-light btn-sm"><i class="fa fa-arrow-left"></i> Back</a>
            </div>
            <div class="card-body">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="row">
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.CategoryName)
                        @Html.TextBoxFor(m => m.CategoryName, new { @class = "form-control", placeholder = "Enter category name" })
                        @Html.ValidationMessageFor(m => m.CategoryName, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.DisplayOrder)
                        @Html.TextBoxFor(m => m.DisplayOrder, new { @class = "form-control", type = "number", min = "0" })
                    </div>
                </div>
                <div class="mb-3">
                    @Html.LabelFor(m => m.CategoryDescription)
                    @Html.TextAreaFor(m => m.CategoryDescription, new { @class = "form-control", rows = "4", placeholder = "Enter description" })
                </div>
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                    @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label" })
                </div>
            </div>
            <div class="card-footer text-end">
                <button class="btn btn-primary" type="submit"><i class="fa fa-save"></i> Save</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
            </div>
        </div>
    }
</div>
