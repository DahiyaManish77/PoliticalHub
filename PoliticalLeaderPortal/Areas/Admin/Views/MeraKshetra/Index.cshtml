@model List<PoliticalLeaderPortal.ViewModels.MeraKshetraItemVM>

@{
    ViewBag.Title = "Mera Kshetra";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="card shadow-sm border-0 admin-pro-card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-0">Mera Kshetra Content</h4>
                <small>Manage heritage, nearby places, development points and citizen-service modules.</small>
            </div>
            <a href="@Url.Action("Create")" class="btn btn-light">
                <i class="bi bi-plus-circle"></i>
                Add Record
            </a>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle admin-data-table">
                    <thead class="table-light">
                        <tr>
                            <th>Image</th>
                            <th>Module</th>
                            <th>Title</th>
                            <th>Location</th>
                            <th>Order</th>
                            <th>Status</th>
                            <th width="190">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                                        {
                                            <img src="@Url.Content(item.ImagePath)" class="admin-kshetra-thumb" alt="@item.Title" />
                                        }
                                        else
                                        {
                                            <span class="admin-kshetra-icon"><i class="@(string.IsNullOrWhiteSpace(item.IconClass) ? "bi bi-geo-alt" : item.IconClass)"></i></span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark">@item.ModuleType</span>
                                        @if (item.IsFeatured)
                                        {
                                            <span class="badge bg-warning text-dark">Featured</span>
                                        }
                                    </td>
                                    <td>
                                        <strong>@item.Title</strong>
                                        @if (!string.IsNullOrWhiteSpace(item.ShortTitle))
                                        {
                                            <small class="d-block text-muted">@item.ShortTitle</small>
                                        }
                                    </td>
                                    <td>
                                        @item.LocationName
                                        @if (!string.IsNullOrWhiteSpace(item.DistanceText))
                                        {
                                            <small class="d-block text-muted">@item.DistanceText</small>
                                        }
                                    </td>
                                    <td>@item.DisplayOrder</td>
                                    <td>
                                        <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                            @(item.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Edit", new { id = item.MeraKshetraItemId })" class="btn btn-warning btn-sm">
                                            <i class="bi bi-pencil-square"></i>
                                            Edit
                                        </a>
                                        <button type="button" class="btn btn-danger btn-sm btn-delete" data-id="@item.MeraKshetraItemId">
                                            <i class="bi bi-trash"></i>
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">No Mera Kshetra records found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            if ($.fn.DataTable && !$.fn.DataTable.isDataTable('.admin-data-table')) {
                $('.admin-data-table').DataTable({
                    pageLength: 10,
                    order: [[4, 'asc']]
                });
            }

            @if (TempData["Success"] != null)
            {
                <text>Swal.fire('Success', '@TempData["Success"]', 'success');</text>
            }

            @if (TempData["Error"] != null)
            {
                <text>Swal.fire('Error', '@TempData["Error"]', 'error');</text>
            }

            $('.btn-delete').on('click', function () {
                var id = $(this).data('id');

                Swal.fire({
                    title: 'Delete record?',
                    text: 'This Mera Kshetra item will be removed from the public page.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'Yes, delete'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        $.post('@Url.Action("Delete")', { id: id }, function (response) {
                            Swal.fire('Deleted', response.message, 'success').then(function () {
                                location.reload();
                            });
                        });
                    }
                });
            });
        });
    </script>
}

<style>
    .admin-kshetra-thumb {
        width: 72px;
        height: 52px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #e7edf5;
    }

    .admin-kshetra-icon {
        display: inline-grid;
        place-items: center;
        width: 52px;
        height: 52px;
        border-radius: 8px;
        background: #eef7fa;
        color: #0b8fa6;
        font-size: 22px;
    }

    .admin-data-table th,
    .admin-data-table td {
        vertical-align: middle;
    }
</style>
