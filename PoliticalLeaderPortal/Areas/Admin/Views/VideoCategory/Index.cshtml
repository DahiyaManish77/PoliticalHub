@model IEnumerable<PoliticalLeaderPortal.ViewModels.VideoCategoryListVM>

@{
    ViewBag.Title = "Video Categories";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="row mb-4">

        <div class="col-md-6">

            <h2 class="fw-bold">
                Video Categories
            </h2>

        </div>

        <div class="col-md-6 text-end">

            <a href="@Url.Action("Create","VideoCategory")"
               class="btn btn-primary">

                <i class="bi bi-plus-circle"></i>
                Add New Category

            </a>

        </div>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">

            @TempData["SuccessMessage"]

        </div>
    }

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-dark">

                        <tr>

                            <th>
                                Category Name
                            </th>

                            <th>
                                Description
                            </th>

                            <th>
                                Total Videos
                            </th>

                            <th>
                                Display Order
                            </th>

                            <th>
                                Status
                            </th>

                            <th style="width:220px;">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td>

                                        <strong>
                                            @item.CategoryName
                                        </strong>

                                    </td>

                                    <td>

                                        @{
                                            string description =
                                                string.IsNullOrWhiteSpace(item.CategoryDescription)
                                                ? ""
                                                : item.CategoryDescription;
                                        }

                                        @(description.Length > 80
                                            ? description.Substring(0, 80) + "..."
                                            : description)

                                    </td>

                                    <td>

                                        <span class="badge bg-info">

                                            @item.TotalVideos

                                        </span>

                                    </td>

                                    <td>

                                        @item.DisplayOrder

                                    </td>

                                    <td>

                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactive
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <a href="@Url.Action(
                                                "Details",
                                                "VideoCategory",
                                                new { id = item.VideoCategoryId })"
                                           class="btn btn-info btn-sm">

                                            View

                                        </a>

                                        <a href="@Url.Action(
                                                "Edit",
                                                "VideoCategory",
                                                new { id = item.VideoCategoryId })"
                                           class="btn btn-warning btn-sm">

                                            Edit

                                        </a>

                                        <a href="@Url.Action(
                                                "Delete",
                                                "VideoCategory",
                                                new { id = item.VideoCategoryId })"
                                           class="btn btn-danger btn-sm">

                                            Delete

                                        </a>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center">

                                    No Video Categories Found

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>