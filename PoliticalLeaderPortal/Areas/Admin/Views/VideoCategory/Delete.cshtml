@model PoliticalLeaderPortal.ViewModels.VideoCategoryVM

@{
    ViewBag.Title = "Delete Video Category";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="row mb-4">

        <div class="col-md-6">

            <h2 class="fw-bold text-danger">
                Delete Video Category
            </h2>

        </div>

        <div class="col-md-6 text-end">

            <a href="@Url.Action("Index","VideoCategory")"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left"></i>
                Back To List

            </a>

        </div>

    </div>

    <div class="alert alert-danger shadow-sm">

        <strong>
            Warning!
        </strong>

        This action will permanently delete this video category.

        <br />

        If videos exist under this category, SQL Server foreign key constraints may prevent deletion.

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <table class="table table-bordered align-middle">

                <tr>

                    <th style="width:250px;">
                        Category ID
                    </th>

                    <td>
                        @Model.VideoCategoryId
                    </td>

                </tr>

                <tr>

                    <th>
                        Category Name
                    </th>

                    <td>
                        @Model.CategoryName
                    </td>

                </tr>

                <tr>

                    <th>
                        Category Description
                    </th>

                    <td>

                        @if (!string.IsNullOrWhiteSpace(Model.CategoryDescription))
                        {
                            @Model.CategoryDescription
                        }
                        else
                        {
                            <span class="text-muted">
                                Not Available
                            </span>
                        }

                    </td>

                </tr>

                <tr>

                    <th>
                        Display Order
                    </th>

                    <td>
                        @Model.DisplayOrder
                    </td>

                </tr>

                <tr>

                    <th>
                        Status
                    </th>

                    <td>

                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Inactive
                            </span>
                        }

                    </td>

                </tr>

                <tr>

                    <th>
                        Created Date
                    </th>

                    <td>
                        @Model.CreatedDate.ToString("dd MMM yyyy hh:mm tt")
                    </td>

                </tr>

                <tr>

                    <th>
                        Updated Date
                    </th>

                    <td>

                        @if (Model.UpdatedDate.HasValue)
                        {
                            @Model.UpdatedDate.Value.ToString("dd MMM yyyy hh:mm tt")
                        }
                        else
                        {
                            <span class="text-muted">
                                Never Updated
                            </span>
                        }

                    </td>

                </tr>

            </table>

        </div>

        <div class="card-footer bg-white">

            @using (Html.BeginForm(
                "Delete",
                "VideoCategory",
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(x => x.VideoCategoryId)

                <button type="submit"
                        class="btn btn-danger">

                    <i class="bi bi-trash"></i>
                    Confirm Delete

                </button>

                <a href="@Url.Action(
                        "Details",
                        "VideoCategory",
                        new { id = Model.VideoCategoryId })"
                   class="btn btn-outline-secondary">

                    Cancel

                </a>
            }

        </div>

    </div>

</div>