@model PoliticalLeaderPortal.Areas.Admin.ViewModels.People.PeopleIndexVM
@using System.Linq
@{
    ViewBag.Title = Model.VolunteersOnly ? "Volunteers" : "People Master";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h3 class="mb-1">@ViewBag.Title</h3>
            <p class="text-muted mb-0">Manage citizens, workers and volunteer profiles from one master record.</p>
        </div>
        <div>
            <a class="btn btn-outline-primary" href="@Url.Action("Index", new { volunteersOnly = !Model.VolunteersOnly })">
                @(Model.VolunteersOnly ? "Show all people" : "Show volunteers")
            </a>
            <a class="btn btn-primary" href="@Url.Action("Create")"><i class="fa fa-plus"></i> Add Person</a>
            <a class="btn btn-success" href="@Url.Action("AddVolunteer")"><i class="fa fa-user-plus"></i> Add Volunteer</a>
        </div>
    </div>

    @if (ViewBag.ModuleInstalled != null && !(bool)ViewBag.ModuleInstalled)
    {
        <div class="alert alert-danger">People module database tables were not found. Restore or create PersonMaster and VolunteerProfile before using this page.</div>
    }

    <div class="row g-3 mb-3">
        <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><small class="text-muted">Total People</small><h3 class="mb-0">@Model.TotalPeople</h3></div></div></div>
        <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><small class="text-muted">Active People</small><h3 class="mb-0">@Model.ActivePeople</h3></div></div></div>
        <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><small class="text-muted">Volunteers</small><h3 class="mb-0">@Model.TotalVolunteers</h3></div></div></div>
        <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><small class="text-muted">Pending Verification</small><h3 class="mb-0">@Model.PendingVerification</h3></div></div></div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            @using (Html.BeginForm("Index", "People", FormMethod.Get, new { @class = "row g-2 mb-3" }))
            {
                <input type="hidden" name="volunteersOnly" value="@Model.VolunteersOnly.ToString().ToLowerInvariant()" />
                <div class="col-lg-5"><input class="form-control" name="keyword" value="@Model.Keyword" placeholder="Search name, mobile or email" /></div>
                <div class="col-lg-3">
                    <select class="form-select" name="status">
                        <option value="">All statuses</option>
                        <option value="Active" @(Model.Status == "Active" ? "selected" : null)>Active</option>
                        <option value="Inactive" @(Model.Status == "Inactive" ? "selected" : null)>Inactive</option>
                        <option value="Pending" @(Model.Status == "Pending" ? "selected" : null)>Pending</option>
                        <option value="Approved" @(Model.Status == "Approved" ? "selected" : null)>Approved</option>
                        <option value="Rejected" @(Model.Status == "Rejected" ? "selected" : null)>Rejected</option>
                        <option value="Verified" @(Model.Status == "Verified" ? "selected" : null)>Verified</option>
                    </select>
                </div>
                <div class="col-lg-3">@Html.DropDownList("assemblyConstituencyId", Model.AssemblyOptions, "All assemblies", new { @class = "form-select" })</div>
                <div class="col-lg-1"><button class="btn btn-dark w-100" type="submit"><i class="fa fa-search"></i></button></div>
            }

            <div class="table-responsive">
                <table class="table table-hover align-middle admin-data-table">
                    <thead class="table-light"><tr><th>Code</th><th>Person</th><th>Volunteer</th><th>Verification</th><th>Status</th><th>Created</th><th width="130">Actions</th></tr></thead>
                    <tbody>
                        @if (Model.Rows != null && Model.Rows.Any())
                        {
                            foreach (var row in Model.Rows)
                            {
                                <tr>
                                    <td><strong>@row.PersonCode</strong></td>
                                    <td><strong>@row.FullName</strong><small class="d-block text-muted">@row.MobileNumber @(!String.IsNullOrWhiteSpace(row.Email) ? "• " + row.Email : "")</small></td>
                                    <td>@if (row.IsVolunteer)
                                    {<span class="badge bg-primary">@(!String.IsNullOrWhiteSpace(row.PreferredRole) ? row.PreferredRole : "Volunteer")</span> <small class="d-block text-muted">@row.VolunteerStatus</small> }
                                else
                                { <span class="text-muted">No</span>}</td>
                                    <td><span class="badge bg-light text-dark">@(!String.IsNullOrWhiteSpace(row.VerificationStatus) ? row.VerificationStatus : "—")</span></td>
                                    <td><span class="badge @(row.IsActive ? "bg-success" : "bg-secondary")">@(row.IsActive ? "Active" : "Inactive")</span></td>
                                    <td>@row.CreatedDate.ToString("dd MMM yyyy")</td>
                                    <td><a class="btn btn-sm btn-warning" href="@Url.Action("Edit", new { id = row.PersonId })"><i class="fa fa-edit"></i></a> <button class="btn btn-sm btn-danger js-delete-person" data-id="@row.PersonId"><i class="fa fa-trash"></i></button></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4">No records found.</td></tr>
}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
$(function () {
    $('.js-delete-person').on('click', function () {
        var id = $(this).data('id');
        if (!confirm('Deactivate this person?')) return;
        $.post('@Url.Action("Delete")', { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val() })
            .done(function (r) { if (r.success) location.reload(); else alert(r.message || 'Unable to update record.'); })
            .fail(function () { alert('Unable to update record.'); });
    });
});
    </script>
    @using (Html.BeginForm())
    {@Html.AntiForgeryToken()}
}
