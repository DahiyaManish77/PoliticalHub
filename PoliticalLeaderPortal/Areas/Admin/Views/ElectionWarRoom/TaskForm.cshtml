@model PoliticalLeaderPortal.Areas.Admin.ViewModels.ElectionWarRoom.EventTaskVM
@{
    bool isEdit = Model != null && Model.EventTaskId > 0;
    ViewBag.Title = isEdit ? "Edit Task" : "Add Task";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-0 fw-bold">@ViewBag.Title</h4>
                <div class="text-muted small">Assign campaign work, ownership, deadline and status.</div>
            </div>
            <a href="@Url.Action("Tasks", "ElectionWarRoom")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
        <div class="card-body">
            @using (Html.BeginForm(isEdit ? "EditTask" : "CreateTask", "ElectionWarRoom", FormMethod.Post, new { @class = "row g-3" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.EventTaskId)
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                <div class="col-md-3">@Html.LabelFor(m => m.EventId, new { @class = "form-label" }) @Html.TextBoxFor(m => m.EventId, new { @class = "form-control", type = "number", min = "1" }) @Html.ValidationMessageFor(m => m.EventId, "", new { @class = "text-danger small" })</div>
                <div class="col-md-9">@Html.LabelFor(m => m.TaskTitle, new { @class = "form-label" }) @Html.TextBoxFor(m => m.TaskTitle, new { @class = "form-control" }) @Html.ValidationMessageFor(m => m.TaskTitle, "", new { @class = "text-danger small" })</div>

                <div class="col-md-4">@Html.LabelFor(m => m.TaskCategory, new { @class = "form-label" }) @Html.TextBoxFor(m => m.TaskCategory, new { @class = "form-control", placeholder = "Logistics, Booth, Media..." })</div>
                <div class="col-md-4">@Html.LabelFor(m => m.Priority, new { @class = "form-label" }) @Html.DropDownListFor(m => m.Priority, new SelectList(new[] { "Low", "Medium", "High", "Critical" }, Model.Priority), "Select", new { @class = "form-select" })</div>
                <div class="col-md-4">@Html.LabelFor(m => m.Status, new { @class = "form-label" }) @Html.DropDownListFor(m => m.Status, new SelectList(new[] { "Pending", "In Progress", "Completed", "On Hold", "Cancelled" }, Model.Status), "Select", new { @class = "form-select" })</div>

                <div class="col-md-6">@Html.LabelFor(m => m.AssignedToName, new { @class = "form-label" }) @Html.TextBoxFor(m => m.AssignedToName, new { @class = "form-control" })</div>
                <div class="col-md-6">@Html.LabelFor(m => m.AssignedToMemberCode, new { @class = "form-label" }) @Html.TextBoxFor(m => m.AssignedToMemberCode, new { @class = "form-control" })</div>

                <div class="col-md-4">@Html.LabelFor(m => m.StartDate, new { @class = "form-label" }) @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })</div>
                <div class="col-md-4">@Html.LabelFor(m => m.DueDate, new { @class = "form-label" }) @Html.TextBoxFor(m => m.DueDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })</div>
                <div class="col-md-4">@Html.LabelFor(m => m.ProgressPercentage, new { @class = "form-label" }) @Html.TextBoxFor(m => m.ProgressPercentage, new { @class = "form-control", type = "number", min = "0", max = "100" })</div>

                <div class="col-12">@Html.LabelFor(m => m.TaskDescription, new { @class = "form-label" }) @Html.TextAreaFor(m => m.TaskDescription, 4, 40, new { @class = "form-control" })</div>
                <div class="col-12">@Html.LabelFor(m => m.Remarks, new { @class = "form-label" }) @Html.TextAreaFor(m => m.Remarks, 3, 40, new { @class = "form-control" })</div>

                <div class="col-12 d-flex gap-4">
                    <div class="form-check">@Html.CheckBoxFor(m => m.IsMilestone, new { @class = "form-check-input" }) @Html.LabelFor(m => m.IsMilestone, new { @class = "form-check-label" })</div>
                    <div class="form-check">@Html.CheckBoxFor(m => m.RequiresApproval, new { @class = "form-check-input" }) @Html.LabelFor(m => m.RequiresApproval, new { @class = "form-check-label" })</div>
                    <div class="form-check">@Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" }) @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label" })</div>
                </div>

                <div class="col-12 d-flex justify-content-end gap-2 border-top pt-3">
                    <a href="@Url.Action("Tasks", "ElectionWarRoom")" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save</button>
                </div>
            }
        </div>
    </div>
</div>
