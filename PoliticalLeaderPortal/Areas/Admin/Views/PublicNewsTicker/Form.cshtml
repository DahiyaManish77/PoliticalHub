@model PoliticalLeaderPortal.Areas.Admin.ViewModels.PublicNewsTickerVM

@{
    bool isEdit = Model != null && Model.PublicNewsTickerId > 0;
    ViewBag.Title = isEdit ? "Edit Ticker Item" : "Add Ticker Item";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <div class="text-uppercase small fw-semibold text-primary">Public News Ticker</div>
                <h4 class="mb-0 fw-bold">@ViewBag.Title</h4>
                <small class="text-muted">This text appears in the black marquee strip above the public website header.</small>
            </div>
            <a href="@Url.Action("Index", "PublicNewsTicker")" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>

        <div class="card-body">
            @using (Html.BeginForm(isEdit ? "Edit" : "Create", "PublicNewsTicker", FormMethod.Post, new { area = "Admin", @class = "row g-3" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.PublicNewsTickerId)
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger col-12" })

                <div class="col-12">
                    @Html.LabelFor(m => m.TickerText, new { @class = "form-label" })
                    @Html.TextAreaFor(m => m.TickerText, 3, 40, new { @class = "form-control", maxlength = "300", placeholder = "Write one marquee/news line" })
                    @Html.ValidationMessageFor(m => m.TickerText, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.LinkUrl, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.LinkUrl, new { @class = "form-control", placeholder = "Optional link URL" })
                    @Html.ValidationMessageFor(m => m.LinkUrl, "", new { @class = "text-danger small" })
                </div>
                <div class="col-md-3">
                    @Html.LabelFor(m => m.Category, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Category, new { @class = "form-control", placeholder = "Breaking News" })
                    @Html.ValidationMessageFor(m => m.Category, "", new { @class = "text-danger small" })
                </div>
                <div class="col-md-3">
                    @Html.LabelFor(m => m.DisplayOrder, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.DisplayOrder, new { @class = "form-control", type = "number", min = "0" })
                    @Html.ValidationMessageFor(m => m.DisplayOrder, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.StartDate, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger small" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.EndDate, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger small" })
                </div>

                <div class="col-12">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                        <label class="form-check-label">Show on public top ticker</label>
                    </div>
                </div>

                <div class="col-12 d-flex justify-content-end gap-2 border-top pt-3">
                    <a href="@Url.Action("Index", "PublicNewsTicker")" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save Ticker</button>
                </div>
            }
        </div>
    </div>
</div>
