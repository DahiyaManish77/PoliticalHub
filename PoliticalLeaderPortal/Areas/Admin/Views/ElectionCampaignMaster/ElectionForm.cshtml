@model PoliticalLeaderPortal.Areas.Admin.ViewModels.ElectionCampaignMaster.ElectionMasterVM
@{ ViewBag.Title = Model.ElectionId > 0 ? "Edit Election" : "Create Election"; Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; }
<link href="@Url.Content("~/Areas/Admin/Content/election-campaign-master.css")" rel="stylesheet" />
<div class="ecm-form-card">
    <div class="ecm-form-head"><h1>@ViewBag.Title</h1><a href="@Url.Action("Index")">Back to masters</a></div>
    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "row g-3" }))
    {@Html.AntiForgeryToken() @Html.HiddenFor(m => m.ElectionId) @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
    <div class="col-md-8">@Html.LabelFor(m => m.ElectionName)<span class="req">*</span>@Html.TextBoxFor(m => m.ElectionName, new { @class = "form-control" })@Html.ValidationMessageFor(m => m.ElectionName)</div><div class="col-md-4">@Html.LabelFor(m => m.ElectionType)<span class="req">*</span>@Html.DropDownListFor(m => m.ElectionType, new SelectList(new[] { "Lok Sabha", "Vidhan Sabha", "Municipal Corporation", "Municipality", "Panchayat", "By Election" }, Model.ElectionType), "Select type", new { @class = "form-select" })</div>
    <div class="col-md-4">@Html.LabelFor(m => m.ElectionYear)@Html.TextBoxFor(m => m.ElectionYear, new { @class = "form-control", type = "number" })</div><div class="col-md-4">@Html.LabelFor(m => m.StateName)@Html.TextBoxFor(m => m.StateName, new { @class = "form-control" })</div><div class="col-md-4">@Html.LabelFor(m => m.DistrictName)@Html.TextBoxFor(m => m.DistrictName, new { @class = "form-control" })</div>
    <div class="col-md-4">@Html.LabelFor(m => m.NotificationDate)@Html.TextBoxFor(m => m.NotificationDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })</div><div class="col-md-4">@Html.LabelFor(m => m.NominationStartDate)@Html.TextBoxFor(m => m.NominationStartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })</div><div class="col-md-4">@Html.LabelFor(m => m.NominationEndDate)@Html.TextBoxFor(m => m.NominationEndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })</div>
    <div class="col-md-4">@Html.LabelFor(m => m.PollingDate)@Html.TextBoxFor(m => m.PollingDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })</div><div class="col-md-4">@Html.LabelFor(m => m.CountingDate)@Html.TextBoxFor(m => m.CountingDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })</div><div class="col-md-4">@Html.LabelFor(m => m.Status)@Html.DropDownListFor(m => m.Status, new SelectList(new[] { "Planning", "Announced", "Nomination", "Campaigning", "Polling", "Counting", "Completed", "Cancelled" }, Model.Status), new { @class = "form-select" })</div>
    <div class="col-12">@Html.LabelFor(m => m.Description)@Html.TextAreaFor(m => m.Description, 4, 20, new { @class = "form-control" })</div><div class="col-12 form-check ms-2">@Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" }) @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label" })</div><div class="col-12"><button class="btn btn-primary px-4">Save Election</button> <a class="btn btn-light" href="@Url.Action("Index")">Cancel</a></div>}
</div>
