@model PoliticalLeaderPortal.Areas.Admin.ViewModels.ElectionCampaignMaster.CampaignMasterVM
@{ ViewBag.Title = Model.CampaignMasterId > 0 ? "Edit Campaign" : "Create Campaign"; Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; }
<link href="@Url.Content("~/Areas/Admin/Content/election-campaign-master.css")" rel="stylesheet" />
<div class="ecm-form-card">
    <div class="ecm-form-head"><h1>@ViewBag.Title</h1><a href="@Url.Action("Index")">Back to masters</a></div>
    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "row g-3" }))
    {@Html.AntiForgeryToken() @Html.HiddenFor(m => m.CampaignMasterId) @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
    <div class="col-md-6">@Html.LabelFor(m => m.ElectionId)<span class="req">*</span>@Html.DropDownListFor(m => m.ElectionId, (IEnumerable<SelectListItem>)ViewBag.Elections, "Select election", new { @class = "form-select" })</div><div class="col-md-6">@Html.LabelFor(m => m.CampaignName)<span class="req">*</span>@Html.TextBoxFor(m => m.CampaignName, new { @class = "form-control" })</div>
    <div class="col-md-4">@Html.LabelFor(m => m.CampaignCode)<span class="req">*</span>@Html.TextBoxFor(m => m.CampaignCode, new { @class = "form-control", placeholder = "VS-2027-001" })</div><div class="col-md-4">@Html.LabelFor(m => m.CandidateName)@Html.TextBoxFor(m => m.CandidateName, new { @class = "form-control" })</div><div class="col-md-4">@Html.LabelFor(m => m.CampaignOwner)@Html.TextBoxFor(m => m.CampaignOwner, new { @class = "form-control" })</div>
    <div class="col-md-6">@Html.LabelFor(m => m.ConstituencyName)@Html.TextBoxFor(m => m.ConstituencyName, new { @class = "form-control" })</div><div class="col-md-3">@Html.LabelFor(m => m.ConstituencyNumber)@Html.TextBoxFor(m => m.ConstituencyNumber, new { @class = "form-control" })</div><div class="col-md-3">@Html.LabelFor(m => m.ProgressPercent)@Html.TextBoxFor(m => m.ProgressPercent, new { @class = "form-control", type = "number", min = "0", max = "100" })</div>
    <div class="col-md-4">@Html.LabelFor(m => m.StartDate)@Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })</div><div class="col-md-4">@Html.LabelFor(m => m.EndDate)@Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })</div><div class="col-md-4">@Html.LabelFor(m => m.Status)@Html.DropDownListFor(m => m.Status, new SelectList(new[] { "Planning", "Active", "On Hold", "Closed", "Cancelled" }, Model.Status), new { @class = "form-select" })</div>
    <div class="col-12">@Html.LabelFor(m => m.Goals)@Html.TextAreaFor(m => m.Goals, 3, 20, new { @class = "form-control", placeholder = "Campaign goals and measurable outcomes" })</div><div class="col-12">@Html.LabelFor(m => m.Description)@Html.TextAreaFor(m => m.Description, 4, 20, new { @class = "form-control" })</div>
    <div class="col-md-6 form-check ms-2">@Html.CheckBoxFor(m => m.IsPrimary, new { @class = "form-check-input" }) @Html.LabelFor(m => m.IsPrimary, new { @class = "form-check-label" })</div><div class="col-md-5 form-check">@Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" }) @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label" })</div><div class="col-12"><button class="btn btn-primary px-4">Save Campaign</button> <a class="btn btn-light" href="@Url.Action("Index")">Cancel</a></div>}
</div>
