


@model PoliticalLeaderPortal.Areas.Admin.ViewModels.WebsiteFooterSettingVM

@{
    ViewBag.Title = "Website Footer Setting";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="card shadow-sm border-0">

        <div class="card-header bg-primary text-white">

            <h4 class="mb-0">
                Website Footer Settings
            </h4>

        </div>

        <div class="card-body">

            @using (Html.BeginForm(
                "Index",
                "WebsiteFooterSetting",
                FormMethod.Post,
                new
                {
                    enctype = "multipart/form-data"
                }))
            {
                @Html.AntiForgeryToken()

                <div class="row">

                    <!-- ABOUT SECTION -->

                    <div class="col-12">

                        <h5 class="border-bottom pb-2 mb-3">
                            Footer Content
                        </h5>

                    </div>

                    <div class="col-md-12 mb-3">

                        <label class="form-label">
                            About Text
                        </label>

                        @Html.TextAreaFor(
                            m => m.AboutText,
                            new
                            {
                                @class = "form-control",
                                rows = "5",
                                placeholder = "About Website / Leader"
                            })

                    </div>

                    <!-- CONTACT INFORMATION -->

                    <div class="col-12 mt-2">

                        <h5 class="border-bottom pb-2 mb-3">
                            Contact Information
                        </h5>

                    </div>

                    <div class="col-md-4 mb-3">

                        <label class="form-label">
                            Address
                        </label>

                        @Html.TextBoxFor(
                            m => m.Address,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Address"
                            })

                    </div>

                    <div class="col-md-4 mb-3">

                        <label class="form-label">
                            Phone Number
                        </label>

                        @Html.TextBoxFor(
                            m => m.PhoneNumber,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Phone Number"
                            })

                    </div>

                    <div class="col-md-4 mb-3">

                        <label class="form-label">
                            Email Address
                        </label>

                        @Html.TextBoxFor(
                            m => m.EmailAddress,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Email Address"
                            })

                    </div>

                    <!-- SOCIAL LINKS -->

                    <div class="col-12 mt-2">

                        <h5 class="border-bottom pb-2 mb-3">
                            Social Media Links
                        </h5>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Facebook URL
                        </label>

                        @Html.TextBoxFor(
                            m => m.FacebookUrl,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Facebook URL"
                            })

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Instagram URL
                        </label>

                        @Html.TextBoxFor(
                            m => m.InstagramUrl,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Instagram URL"
                            })

                    </div>

                    <div class="col-md-4 mb-3">

                        <label class="form-label">
                            Twitter URL
                        </label>

                        @Html.TextBoxFor(
                            m => m.TwitterUrl,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Twitter URL"
                            })

                    </div>

                    <div class="col-md-4 mb-3">

                        <label class="form-label">
                            YouTube URL
                        </label>

                        @Html.TextBoxFor(
                            m => m.YoutubeUrl,
                            new
                            {
                                @class = "form-control",
                                placeholder = "YouTube URL"
                            })

                    </div>

                    <div class="col-md-4 mb-3">

                        <label class="form-label">
                            WhatsApp URL
                        </label>

                        @Html.TextBoxFor(
                            m => m.WhatsappUrl,
                            new
                            {
                                @class = "form-control",
                                placeholder = "WhatsApp URL"
                            })

                    </div>

                    <!-- FOOTER LOGO -->

                    <div class="col-12 mt-2">

                        <h5 class="border-bottom pb-2 mb-3">
                            Footer Branding
                        </h5>

                    </div>

                    <div class="col-md-6 mb-4">

                        <label class="form-label">
                            Footer Logo
                        </label>

                        <input type="file"
                               name="FooterLogoFile"
                               class="form-control" />

                        @if (!string.IsNullOrWhiteSpace(Model.FooterLogoPath))
                        {
                            <div class="mt-3">

                                <img src="@Url.Content(Model.FooterLogoPath)"
                                     class="img-thumbnail"
                                     style="max-height:100px;" />

                            </div>
                        }

                    </div>

                    <!-- COPYRIGHT -->

                    <div class="col-md-6 mb-4">

                        <label class="form-label">
                            Copyright Text
                        </label>

                        @Html.TextAreaFor(
                            m => m.CopyrightText,
                            new
                            {
                                @class = "form-control",
                                rows = "4",
                                placeholder = "Copyright Text"
                            })

                    </div>

                    <!-- ACTIVE -->

                    <div class="col-md-3 mb-4">

                        <div class="form-check mt-4">

                            @Html.CheckBoxFor(
                                m => m.IsActive,
                                new
                                {
                                    @class = "form-check-input"
                                })

                            <label class="form-check-label">
                                Footer Active
                            </label>

                        </div>

                    </div>

                    <!-- BUTTON -->

                    <div class="col-12">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-save"></i>

                            Save Footer Settings

                        </button>

                    </div>

                </div>
            }

        </div>

    </div>

</div>

@section Scripts
{
    @if (TempData["Success"] != null)
    {
        <script>

            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: '@TempData["Success"]'
            });

        </script>
    }
}
