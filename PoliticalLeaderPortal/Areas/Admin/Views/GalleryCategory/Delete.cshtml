@model PoliticalLeaderPortal.ViewModels.GalleryCategoryVM

@{
    ViewBag.Title = "Delete Gallery Category";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="row mb-4">

        <div class="col-md-6">

            <h2 class="fw-bold text-danger">
                Delete Gallery Category
            </h2>

        </div>

        <div class="col-md-6 text-end">

            <a href="@Url.Action("Index", "GalleryCategory")"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left"></i>
                Back To List

            </a>

        </div>

    </div>

    <div class="alert alert-danger">

        <h5 class="mb-2">

            <i class="bi bi-exclamation-triangle-fill"></i>
            Warning

        </h5>

        <p class="mb-0">

            You are about to permanently delete this gallery category.

            This action cannot be undone.

        </p>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">

                    @if (!string.IsNullOrWhiteSpace(Model.CoverImagePath))
                    {
                        <img src="@Url.Content(Model.CoverImagePath)"
                             class="img-fluid rounded border"
                             style="width:100%;height:300px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="border rounded d-flex align-items-center justify-content-center"
                             style="height:300px;background:#f8f9fa;">

                            <span class="text-muted">
                                No Cover Image
                            </span>

                        </div>
                    }

                </div>

                <div class="col-md-8">

                    <table class="table table-bordered">

                        <tr>

                            <th style="width:220px;">
                                Category Name
                            </th>

                            <td>
                                @Model.CategoryName
                            </td>

                        </tr>

                        <tr>

                            <th>
                                Description
                            </th>

                            <td>

                                @if (!string.IsNullOrWhiteSpace(Model.CategoryDescription))
                                {
                                    @Model.CategoryDescription
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No Description Available
                                    </span>
                                }

                            </td>

                        </tr>

                        <tr>

                            <th>
                                Display Order
                            </th>

                            <td>
                                @Model.DisplayOrder
                            </td>

                        </tr>

                        <tr>

                            <th>
                                Status
                            </th>

                            <td>

                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Inactive
                                    </span>
                                }

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

        </div>

        <div class="card-footer bg-white">

            @using (Html.BeginForm("Delete", "GalleryCategory", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(x => x.GalleryCategoryId)

                <button type="submit"
                        class="btn btn-danger">

                    <i class="bi bi-trash"></i>
                    Confirm Delete

                </button>

                <a href="@Url.Action("Index", "GalleryCategory")"
                   class="btn btn-outline-secondary">

                    Cancel

                </a>
            }

        </div>

    </div>

</div>