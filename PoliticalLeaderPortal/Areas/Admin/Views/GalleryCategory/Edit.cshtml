@model PoliticalLeaderPortal.ViewModels.GalleryCategoryVM

@{
    ViewBag.Title = "Edit Gallery Category";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="row mb-4">

        <div class="col-md-6">

            <h2 class="fw-bold">
                Edit Gallery Category
            </h2>

        </div>

        <div class="col-md-6 text-end">

            <a href="@Url.Action("Index","GalleryCategory")"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left"></i>
                Back To List

            </a>

        </div>

    </div>

    @using (Html.BeginForm(
        "Edit",
        "GalleryCategory",
        FormMethod.Post,
        new
        {
            enctype = "multipart/form-data"
        }))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(x => x.GalleryCategoryId)
        @Html.HiddenFor(x => x.CoverImagePath)

        <div class="card shadow-sm border-0">

            <div class="card-body">

                <div class="row">

                    <div class="col-md-8">

                        <div class="mb-3">

                            @Html.LabelFor(x => x.CategoryName,
                                new { @class = "form-label fw-semibold" })

                            @Html.TextBoxFor(x => x.CategoryName,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Enter category name"
                                })

                            @Html.ValidationMessageFor(x => x.CategoryName,
                                "",
                                new { @class = "text-danger" })

                        </div>

                        <div class="mb-3">

                            @Html.LabelFor(x => x.CategoryDescription,
                                new { @class = "form-label fw-semibold" })

                            @Html.TextAreaFor(x => x.CategoryDescription,
                                new
                                {
                                    @class = "form-control",
                                    rows = "6",
                                    placeholder = "Enter category description"
                                })

                            @Html.ValidationMessageFor(x => x.CategoryDescription,
                                "",
                                new { @class = "text-danger" })

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Change Cover Image
                            </label>

                            <input type="file"
                                   name="CoverImageFile"
                                   id="CoverImageFile"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp" />

                        </div>

                        <div class="mb-3">

                            @if (!string.IsNullOrWhiteSpace(Model.CoverImagePath))
                            {
                                <img id="imagePreview"
                                     src="@Url.Content(Model.CoverImagePath)"
                                     class="img-fluid img-thumbnail"
                                     style="width:100%;height:250px;object-fit:cover;" />
                            }
                            else
                            {
                                <img id="imagePreview"
                                     src="https://placehold.co/400x250?text=No+Image"
                                     class="img-fluid img-thumbnail"
                                     style="width:100%;height:250px;object-fit:cover;" />
                            }

                        </div>

                    </div>

                </div>

                <hr />

                <div class="row">

                    <div class="col-md-3">

                        <div class="mb-3">

                            @Html.LabelFor(x => x.DisplayOrder,
                                new { @class = "form-label fw-semibold" })

                            @Html.TextBoxFor(x => x.DisplayOrder,
                                new
                                {
                                    @class = "form-control",
                                    type = "number"
                                })

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="form-check mt-4">

                            @Html.CheckBoxFor(x => x.IsActive,
                                new
                                {
                                    @class = "form-check-input"
                                })

                            @Html.LabelFor(x => x.IsActive,
                                new
                                {
                                    @class = "form-check-label"
                                })

                        </div>

                    </div>

                </div>

            </div>

            <div class="card-footer bg-white">

                <button type="submit"
                        class="btn btn-warning">

                    <i class="bi bi-pencil-square"></i>
                    Update Category

                </button>

                <a href="@Url.Action("Index","GalleryCategory")"
                   class="btn btn-outline-secondary">

                    Cancel

                </a>

            </div>

        </div>
    }

</div>

@section Scripts{

    Scripts.Render("~/bundles/jqueryval")

    <script>

        $(document).ready(function () {

            $("#CoverImageFile").change(function () {

                var input = this;

                if (input.files && input.files[0]) {

                    var reader = new FileReader();

                    reader.onload = function (e) {

                        $("#imagePreview")
                            .attr("src", e.target.result);

                    };

                    reader.readAsDataURL(input.files[0]);

                }

            });

        });

    </script>

}