@model List<PoliticalLeaderPortal.Areas.Admin.ViewModels.Menu.MenuVM>
@{ Layout = null; }
<ul class="admin-menu master-admin-menu">
    @if (Model != null)
    {
        foreach (var menu in Model)
        {
            @Html.Partial("_AdminSidebarItem", menu)
        }
    }
    <li class="admin-menu-item admin-menu-logout">
        @using (Html.BeginForm("Logout", "Account", new { area = "" }, FormMethod.Post, new { @class = "admin-menu-logout-form" }))
        {
            @Html.AntiForgeryToken()
            <button type="submit"><i class="fas fa-sign-out-alt"></i><span>Logout</span></button>
        }
    </li>
</ul>
