        Url.Action(action, controller, new { area = String.IsNullOrWhiteSpace(area) ? "Admin" : area });

    Func<string, bool> isActive = url =>
        !String.IsNullOrWhiteSpace(url) &&
        url != "#" &&
        currentPath.StartsWith(url.ToLower());
}

