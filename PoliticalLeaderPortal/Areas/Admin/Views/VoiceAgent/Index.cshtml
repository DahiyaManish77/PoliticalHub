@model PoliticalLeaderPortal.Areas.Admin.ViewModels.VoiceAgent.VoiceAgentDashboardVM
@{
    ViewBag.Title = "Voice Agent";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div><span class="text-primary small fw-semibold text-uppercase">Communication &amp; Media</span><h2 class="fw-bold mb-1">Voice Agent</h2><p class="text-muted mb-0">Receive calls, track missed calls and securely manage recordings and transcripts.</p></div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary" href="@Url.Action("BulkCaller")"><i class="bi bi-telephone-outbound me-1"></i>Bulk caller</a>
            <a class="btn btn-primary" href="@Url.Action("Settings")"><i class="bi bi-gear me-1"></i>Provider settings</a>
        </div>
    </div>
    @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
    @if (!Model.IsConfigured || !Model.IsEnabled)
    {
        <div class="alert alert-warning border-0 shadow-sm"><strong>API connection pending.</strong> The module is ready. Purchase a voice API and enter its number and credentials in Provider settings.</div>
    }
    <div class="card border-0 shadow-sm mb-4"><div class="card-body">
        <div class="d-flex flex-wrap justify-content-between gap-3 mb-3"><div><h5 class="fw-bold mb-1">Connection readiness</h5><span class="text-muted">Provider: <strong>@Model.ProviderName</strong> · Number: <strong>@(String.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Not connected" : Model.PhoneNumber)</strong></span></div><div class="text-end"><strong class="fs-4">@Model.ReadinessPercent%</strong><div class="small text-muted">ready</div></div></div>
        <div class="progress mb-3" style="height:8px"><div class="progress-bar bg-@(Model.ReadinessPercent==100?"success":"warning")" style="width:@Model.ReadinessPercent%"></div></div>
        @if(Model.MissingConfiguration.Any()){<div class="small text-danger mb-3">Missing: @String.Join(", ",Model.MissingConfiguration)</div>}
        @{ var hooks = new[] { new { L="Incoming call (POST)",U=Model.IncomingWebhookUrl },new{L="Call status (POST)",U=Model.StatusWebhookUrl},new{L="Recording complete (POST)",U=Model.RecordingWebhookUrl},new{L="Health check (GET)",U=Model.HealthCheckUrl} }; }
        <div class="row g-2">@foreach(var hook in hooks){<div class="col-lg-6"><label class="form-label small fw-semibold">@hook.L</label><div class="input-group"><input class="form-control form-control-sm font-monospace" readonly value="@hook.U"/><button class="btn btn-sm btn-outline-secondary" type="button" onclick="navigator.clipboard.writeText(this.previousElementSibling.value)">Copy</button></div></div>}</div>
        <div class="mt-3 d-flex gap-2"><a class="btn btn-primary" href="@Url.Action("Settings")">Complete setup</a>@using(Html.BeginForm("TestCall","VoiceAgent",FormMethod.Post,new{@class="d-inline"})){@Html.AntiForgeryToken()<button class="btn btn-outline-success">Create test call</button>}</div>
    </div></div>
    <div class="row g-3 mb-4">
        @{ var cards = new[] { new { T="Total calls",V=Model.TotalCalls,I="bi-telephone",C="primary" },new{T="Answered",V=Model.AnsweredCalls,I="bi-telephone-inbound",C="success"},new{T="Missed",V=Model.MissedCalls,I="bi-telephone-x",C="danger"},new{T="Calls today",V=Model.CallsToday,I="bi-calendar2-check",C="info"},new{T="Total minutes",V=Model.TotalMinutes,I="bi-clock-history",C="secondary"} }; }
        @foreach (var card in cards) { <div class="col-sm-6 col-xl"><div class="card border-0 shadow-sm h-100"><div class="card-body"><i class="bi @card.I text-@card.C"></i><div class="text-muted small mt-2">@card.T</div><div class="fs-2 fw-bold">@card.V</div></div></div></div> }
    </div>
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between"><h5 class="mb-0 fw-bold">Recent calls</h5><span class="badge text-bg-light">@Model.Calls.Count records</span></div>
        <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Caller</th><th>Date</th><th>Direction</th><th>Duration</th><th>Purpose</th><th>Status</th><th>Recording</th><th></th></tr></thead><tbody>
        @foreach (var call in Model.Calls) {
            <tr><td><strong>@(String.IsNullOrWhiteSpace(call.CallerNumber)?"Unknown":call.CallerNumber)</strong><div class="small text-muted">@call.ProviderCallId</div></td><td>@call.StartedAt.ToString("dd MMM yyyy, hh:mm tt")</td><td>@call.Direction</td><td>@TimeSpan.FromSeconds(call.DurationSeconds).ToString(@"mm\:ss")</td><td>@(String.IsNullOrWhiteSpace(call.Intent)?"Not classified":call.Intent)</td><td><span class="badge text-bg-@(call.Status=="completed"||call.Status=="answered"?"success":call.Status=="missed"||call.Status=="failed"||call.Status=="no-answer"?"danger":"warning")">@call.Status</span></td><td>@(call.HasRecording?"Available":"—")</td><td><a class="btn btn-sm btn-outline-primary" href="@Url.Action("Details",new{id=call.VoiceCallId})">Open</a></td></tr>
        }
        @if(!Model.Calls.Any()){<tr><td colspan="8" class="text-center text-muted py-5">No calls received yet. Calls will appear after the provider webhook is connected.</td></tr>}
        </tbody></table></div>
    </div>
</div>
