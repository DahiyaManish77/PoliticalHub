
@model PoliticalLeaderPortal.Areas.Admin.ViewModels.Menu.MenuEditVM

<!-- ========================================================= -->
<!-- SAVE PANEL                                                 -->
<!-- ========================================================= -->

<div class="menu-card menu-save-card">

    <div class="menu-card-body">

        <h5 class="mb-2">

            <i class="fas fa-save text-primary me-2"></i>

            Ready to Save

        </h5>

        <p class="text-muted mb-4">

            Review your settings before saving.

        </p>

        <div class="d-grid gap-2">

            <button type="submit"
                    class="btn btn-primary btn-lg">

                <i class="fas fa-save me-2"></i>

                @(Model.MenuId == 0
                    ? "Save Menu"
                    : "Update Menu")

            </button>

            <button type="reset"
                    class="btn btn-warning">

                <i class="fas fa-redo me-2"></i>

                Reset Form

            </button>

            <a href="@Url.Action("Index", "MenuCMS")"
               class="btn btn-outline-secondary">

                <i class="fas fa-arrow-left me-2"></i>

                Back to Menu List

            </a>

        </div>

    </div>

</div>