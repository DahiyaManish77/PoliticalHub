@model PoliticalLeaderPortal.Areas.Admin.ViewModels.Menu.MenuEditVM

<!-- ========================================================= -->
<!-- LIVE PREVIEW                                               -->
<!-- ========================================================= -->

<div class="menu-card menu-shadow menu-rounded">

    <!-- Card Header -->
    <div class="menu-card-header">

        <div class="menu-card-header-left">

            <div class="menu-card-header-icon">
                <i class="fas fa-desktop"></i>
            </div>

            <div class="menu-card-header-content">

                <h5 class="menu-card-title">
                    Live Preview
                </h5>

                <div class="menu-card-subtitle">
                    Preview how this navigation item will appear on the website.
                </div>

            </div>

        </div>

    </div>

    <!-- Card Body -->
    <div class="menu-card-body">

        <div class="menu-preview">

            <div class="menu-preview-header">

                <div class="menu-preview-title">
                    Navigation Preview
                </div>

            </div>

            <div class="menu-preview-body">

                <div class="menu-preview-window">

                    <div class="menu-preview-browser">

                        <div class="menu-preview-navbar">

                            <div class="menu-preview-menu">

                                <div class="menu-preview-item menu-preview-selected">

                                    <i id="previewIcon"
                                       class="fas fa-bars"></i>

                                    <span id="previewMenuName"
                                          class="menu-preview-name">
                                        Menu Name
                                    </span>

                                </div>

                            </div>

                        </div>

                        <div class="menu-preview-route"
                             id="previewRoute">

                            Controller / Action

                        </div>

                    </div>

                </div>

            </div>

            <div class="menu-preview-footer">

                <div class="menu-preview-status">
                    Live preview updates automatically while editing.
                </div>

            </div>

        </div>

    </div>

</div>

<!-- ========================================================= -->
<!-- QUALITY CHECK                                              -->
<!-- ========================================================= -->

<div class="menu-card menu-shadow menu-rounded">

    <!-- Card Header -->
    <div class="menu-card-header">

        <div class="menu-card-header-left">

            <div class="menu-card-header-icon">
                <i class="fas fa-award"></i>
            </div>

            <div class="menu-card-header-content">

                <h5 class="menu-card-title">
                    Quality Check
                </h5>

                <div class="menu-card-subtitle">
                    Verify that all recommended information has been completed.
                </div>

            </div>

        </div>

    </div>

    <!-- Card Body -->
    <div class="menu-card-body">

        <div class="menu-quality">

            <div class="menu-quality-header">

                <div class="menu-quality-title">
                    Form Completion Status
                </div>

                <div class="menu-quality-score">
                    Ready
                </div>

            </div>

            <div class="menu-quality-body">

                <div class="menu-quality-list">

                    <div id="checkMenuName" class="menu-quality-item">

                        <span class="menu-quality-status">
                            <i class="fas fa-times"></i>
                        </span>

                        <span class="menu-quality-label">
                            Menu Name
                        </span>

                    </div>

                    <div id="checkController" class="menu-quality-item">

                        <span class="menu-quality-status">
                            <i class="fas fa-times"></i>
                        </span>

                        <span class="menu-quality-label">
                            Controller
                        </span>

                    </div>

                    <div id="checkAction" class="menu-quality-item">

                        <span class="menu-quality-status">
                            <i class="fas fa-times"></i>
                        </span>

                        <span class="menu-quality-label">
                            Action
                        </span>

                    </div>

                    <div id="checkIcon" class="menu-quality-item">

                        <span class="menu-quality-status">
                            <i class="fas fa-times"></i>
                        </span>

                        <span class="menu-quality-label">
                            Icon
                        </span>

                    </div>

                </div>

            </div>

            <div class="menu-quality-summary">

                Complete all required fields to improve menu quality and consistency.

            </div>

        </div>

    </div>

</div>