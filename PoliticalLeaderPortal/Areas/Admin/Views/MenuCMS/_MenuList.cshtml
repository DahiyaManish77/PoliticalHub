
@model IEnumerable<PoliticalLeaderPortal.Areas.Admin.ViewModels.Menu.MenuListVM>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">

        <i class="fas fa-info-circle me-2"></i>

        No menu records found.

    </div>

    return;
}

<div class="card shadow-sm">

    <div class="card-header bg-white">

        <h5 class="mb-0">

            <i class="fas fa-list me-2"></i>

            Menu List

        </h5>

    </div>

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th width="60">#</th>

                        <th>Menu</th>

                        <th>Parent</th>

                        <th>Type</th>

                        <th>Route</th>

                        <th width="90">Order</th>

                        <th width="90">Status</th>

                        <th width="90">Home</th>

                        <th width="90">Sidebar</th>

                        <th width="90">Footer</th>

                        <th width="110">Quick Links</th>

                        <th width="170" class="text-center">Action</th>

                    </tr>

                </thead>

                <tbody>

                    @{
                        int sr = 1;
                    }

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@sr</td>

                            <td>

                                <i class="@item.IconClass me-2"></i>

                                <strong>@item.MenuName</strong>

                            </td>

                            <td>

                                @(string.IsNullOrWhiteSpace(item.ParentMenuName)
                                    ? "-"
                                    : item.ParentMenuName)

                            </td>

                            <td>@item.MenuType</td>

                            <td>

                                @if (!string.IsNullOrWhiteSpace(item.ControllerName))
                                {
                                    @item.AreaName

                                    <text>/</text>

                                    @item.ControllerName

                                    <text>/</text>

                                    @item.ActionName
                                }
                                else
                                {
                                    <span>-</span>
                                }

                            </td>

                            <td>

                                @item.DisplayOrder

                            </td>

                            <td>

                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">

                                        Active

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">

                                        Inactive

                                    </span>
                                }

                            </td>

                            <td>

                                @if (item.ShowOnHome)
                                {
                                    <i class="fas fa-check text-success"></i>
                                }
                                else
                                {
                                    <i class="fas fa-times text-danger"></i>
                                }

                            </td>

                            <td>

                                @if (item.ShowInAdminSidebar)
                                {
                                    <i class="fas fa-check text-success"></i>
                                }
                                else
                                {
                                    <i class="fas fa-times text-danger"></i>
                                }

                            </td>

                            <td>

                                @if (item.ShowInFooter)
                                {
                                    <i class="fas fa-check text-success"></i>
                                }
                                else
                                {
                                    <i class="fas fa-times text-danger"></i>
                                }

                            </td>

                            <td>

                                @if (item.ShowInQuickLinks)
                                {
                                    <i class="fas fa-check text-success"></i>
                                }
                                else
                                {
                                    <i class="fas fa-times text-danger"></i>
                                }

                            </td>

                            <td class="text-center">

                                <a href="@Url.Action("EditMenu","MenuCMS",new { id=item.MenuId })"
                                   class="btn btn-sm btn-primary">

                                    <i class="fas fa-edit"></i>

                                </a>

                                <button type="button"
                                        class="btn btn-sm btn-warning btnToggle"
                                        data-id="@item.MenuId">

                                    <i class="fas fa-power-off"></i>

                                </button>

                                <button type="button"
                                        class="btn btn-sm btn-danger btnDelete"
                                        data-id="@item.MenuId">

                                    <i class="fas fa-trash"></i>

                                </button>

                            </td>

                        </tr>

                        sr++;
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>