@model PoliticalLeaderPortal.Areas.Admin.ViewModels.LatestNewsVM

@Html.AntiForgeryToken()
@Html.HiddenFor(m => m.NewsId)
@Html.HiddenFor(m => m.ImagePath)

<div class="admin-page-header cms-page-header">
    <div>
        <p class="admin-eyebrow">Website CMS</p>
        <h1>@ViewBag.Title</h1>
        <p>Publish campaign activities, announcements, constituency updates and media notes.</p>
    </div>
    <div class="admin-page-actions">
        <a href="@Url.Action("Index")" class="btn btn-outline-primary">
            <i class="fas fa-arrow-left"></i>
            Back to News
        </a>
    </div>
</div>

<div class="admin-card leader-cms-card news-editor-card">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="cms-form-grid">
                <div class="form-group form-group-wide">
                    <label>Title</label>
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "Enter news title" })
                </div>

                <div class="form-group">
                    <label>Publish Date</label>
                    @Html.TextBoxFor(m => m.PublishDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                </div>

                <div class="form-group">
                    <label>Display Order</label>
                    @Html.TextBoxFor(m => m.DisplayOrder, new { @class = "form-control", type = "number", min = "0" })
                </div>

                <div class="form-group form-group-wide">
                    <label>Short Description</label>
                    @Html.TextAreaFor(m => m.ShortDescription, new { @class = "form-control", rows = "4", placeholder = "Short summary for homepage cards" })
                </div>

                <div class="form-group form-group-wide">
                    <label>Full Description</label>
                    @Html.TextAreaFor(m => m.FullDescription, new { @class = "form-control", rows = "9", placeholder = "Full news content" })
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="leader-cms-side">
                <div class="leader-cms-preview news-editor-preview">
                    <img src="@Url.Content(String.IsNullOrWhiteSpace(Model.ImagePath) ? "~/Content/images/no-image-news.jpg" : Model.ImagePath)" alt="@Model.Title" />
                    <strong>@(String.IsNullOrWhiteSpace(Model.Title) ? "News preview" : Model.Title)</strong>
                    <span>@Model.PublishDate.ToString("dd MMM yyyy")</span>
                </div>

                <div class="form-group">
                    <label>News Image</label>
                    <input type="file" name="ImageFile" class="form-control" />
                </div>

                <label class="cms-check">
                    @Html.CheckBoxFor(m => m.IsFeatured)
                    <span>Feature this news on homepage</span>
                </label>

                <label class="cms-check">
                    @Html.CheckBoxFor(m => m.IsActive)
                    <span>Publish this news</span>
                </label>

                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-save"></i>
                    Save News
                </button>
            </div>
        </div>
    </div>
</div>
