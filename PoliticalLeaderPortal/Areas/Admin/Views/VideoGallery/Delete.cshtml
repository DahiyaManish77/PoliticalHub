@model PoliticalLeaderPortal.ViewModels.VideoGalleryVM

@{
    ViewBag.Title = "Delete Video";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="row mb-4">

        <div class="col-md-6">

            <h2 class="fw-bold text-danger">
                Delete Video
            </h2>

        </div>

        <div class="col-md-6 text-end">

            <a href="@Url.Action("Index","VideoGallery")"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left"></i>
                Back To List

            </a>

        </div>

    </div>

    <div class="alert alert-danger shadow-sm">

        <strong>
            Warning!
        </strong>

        This action will permanently delete this video.

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="row">

                <div class="col-lg-4 mb-4">

                    @if (!string.IsNullOrWhiteSpace(Model.ThumbnailImagePath))
                    {
                        <img src="@Url.Content(Model.ThumbnailImagePath)"
                             class="img-fluid rounded border shadow-sm"
                             style="width:100%;
                                    height:250px;
                                    object-fit:cover;" />
                    }
                    else
                    {
                        <div class="border rounded d-flex align-items-center justify-content-center"
                             style="height:250px;background:#f8f9fa;">

                            <span class="text-muted">
                                No Thumbnail Available
                            </span>

                        </div>
                    }

                </div>

                <div class="col-lg-8">

                    <table class="table table-bordered align-middle">

                        <tr>

                            <th style="width:220px;">
                                Video ID
                            </th>

                            <td>
                                @Model.VideoId
                            </td>

                        </tr>

                        <tr>

                            <th>
                                Video Title
                            </th>

                            <td>
                                @Model.VideoTitle
                            </td>

                        </tr>

                        <tr>

                            <th>
                                Category ID
                            </th>

                            <td>
                                @Model.VideoCategoryId
                            </td>

                        </tr>

                        <tr>

                            <th>
                                YouTube URL
                            </th>

                            <td>

                                @if (!string.IsNullOrWhiteSpace(Model.YoutubeUrl))
                                {
                                    <a href="@Model.YoutubeUrl"
                                       target="_blank">

                                        @Model.YoutubeUrl

                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not Available
                                    </span>
                                }

                            </td>

                        </tr>

                        <tr>

                            <th>
                                Description
                            </th>

                            <td>

                                @if (!string.IsNullOrWhiteSpace(Model.VideoDescription))
                                {
                                    @Model.VideoDescription
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No Description Available
                                    </span>
                                }

                            </td>

                        </tr>

                        <tr>

                            <th>
                                Display Order
                            </th>

                            <td>
                                @Model.DisplayOrder
                            </td>

                        </tr>

                        <tr>

                            <th>
                                Featured Video
                            </th>

                            <td>

                                @if (Model.IsFeatured)
                                {
                                    <span class="badge bg-warning text-dark">
                                        Featured
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Normal
                                    </span>
                                }

                            </td>

                        </tr>

                        <tr>

                            <th>
                                Status
                            </th>

                            <td>

                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Inactive
                                    </span>
                                }

                            </td>

                        </tr>

                        <tr>

                            <th>
                                Created Date
                            </th>

                            <td>
                                @Model.CreatedDate.ToString("dd MMM yyyy hh:mm tt")
                            </td>

                        </tr>

                        <tr>

                            <th>
                                Updated Date
                            </th>

                            <td>

                                @if (Model.UpdatedDate.HasValue)
                                {
                                    @Model.UpdatedDate.Value.ToString("dd MMM yyyy hh:mm tt")
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Never Updated
                                    </span>
                                }

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

        </div>

        <div class="card-footer bg-white">

            @using (Html.BeginForm(
                "Delete",
                "VideoGallery",
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(x => x.VideoId)

                <button type="submit"
                        class="btn btn-danger">

                    <i class="bi bi-trash"></i>
                    Confirm Delete

                </button>

                <a href="@Url.Action(
                        "Details",
                        "VideoGallery",
                        new { id = Model.VideoId })"
                   class="btn btn-outline-secondary">

                    Cancel

                </a>
            }

        </div>

    </div>

</div>