@{
    ViewBag.Title = "Achievements";

    ViewBag.PageTitle = "Achievements";

    ViewBag.PageDescription = "Major milestones, public initiatives and development-oriented work.";

    ViewBag.BannerImage = Url.Content("~/Content/User/images/banners/achievements-banner.jpg");

    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

@Html.Partial("_PageBanner")

<section class="about-page-section">

    <div class="container">

        <div class="row">

            <!-- SIDEBAR -->

            <div class="col-lg-4 col-xl-3">

                @Html.Partial("_AboutLeaderSidebar")

            </div>

            <!-- CONTENT -->

            <div class="col-lg-8 col-xl-9">

                <!-- INTRODUCTION -->

                <div class="about-content-card">

                    <span class="about-page-badge">

                        Achievements

                    </span>

                    <h2 class="about-page-title">

                        Commitment Towards Public Service & Development

                    </h2>

                    <p class="about-page-text">

                        Throughout public life, various initiatives have been undertaken
                        with the objective of strengthening infrastructure, improving
                        civic amenities and addressing public concerns. The following
                        highlights represent important focus areas and achievements.

                    </p>

                </div>

                <!-- HIGHLIGHTS -->

                <div class="row g-4">

                    <div class="col-md-6">

                        <div class="leader-service-card">

                            <i class="fas fa-road"></i>

                            <h5>

                                Infrastructure Development

                            </h5>

                            <p>

                                Focus on roads, connectivity, public facilities and
                                development-oriented projects.

                            </p>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="leader-service-card">

                            <i class="fas fa-school"></i>

                            <h5>

                                Education Support

                            </h5>

                            <p>

                                Encouraging educational development and youth
                                empowerment initiatives.

                            </p>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="leader-service-card">

                            <i class="fas fa-heartbeat"></i>

                            <h5>

                                Healthcare Initiatives

                            </h5>

                            <p>

                                Supporting health awareness programmes and
                                public welfare activities.

                            </p>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="leader-service-card">

                            <i class="fas fa-seedling"></i>

                            <h5>

                                Farmer Welfare

                            </h5>

                            <p>

                                Continuous efforts towards agriculture and
                                rural development.

                            </p>

                        </div>

                    </div>

                </div>

                <!-- MAJOR INITIATIVES -->

                <div class="about-content-card mt-4">

                    <h3>

                        Major Focus Areas

                    </h3>

                    <div class="row g-4">

                        <div class="col-lg-6">

                            <div class="leader-fact-card">

                                <h6>

                                    Public Infrastructure

                                </h6>

                                <p>

                                    Supporting projects related to roads,
                                    drainage, electricity and public amenities.

                                </p>

                            </div>

                        </div>

                        <div class="col-lg-6">

                            <div class="leader-fact-card">

                                <h6>

                                    Citizen Outreach

                                </h6>

                                <p>

                                    Regular interaction with citizens to understand
                                    local issues and encourage public participation.

                                </p>

                            </div>

                        </div>

                        <div class="col-lg-6">

                            <div class="leader-fact-card">

                                <h6>

                                    Social Welfare

                                </h6>

                                <p>

                                    Supporting programmes focused on welfare,
                                    community development and public awareness.

                                </p>

                            </div>

                        </div>

                        <div class="col-lg-6">

                            <div class="leader-fact-card">

                                <h6>

                                    Youth Development

                                </h6>

                                <p>

                                    Encouraging youth participation through
                                    education, sports and leadership initiatives.

                                </p>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- MILESTONES -->

                <div class="about-content-card">

                    <h3>

                        Milestones

                    </h3>

                    <div class="leader-timeline">

                        <div class="timeline-item">

                            <div class="timeline-year">

                                2012

                            </div>

                            <div class="timeline-content">

                                <h5>

                                    Public Representation

                                </h5>

                                <p>

                                    Represented the constituency with a focus on
                                    development and public engagement.

                                </p>

                            </div>

                        </div>

                        <div class="timeline-item">

                            <div class="timeline-year">

                                2017

                            </div>

                            <div class="timeline-content">

                                <h5>

                                    Development Initiatives

                                </h5>

                                <p>

                                    Continued emphasis on infrastructure,
                                    citizen services and welfare activities.

                                </p>

                            </div>

                        </div>

                        <div class="timeline-item">

                            <div class="timeline-year">

                                Present

                            </div>

                            <div class="timeline-content">

                                <h5>

                                    Public Service

                                </h5>

                                <p>

                                    Ongoing engagement with citizens and
                                    participation in community development.

                                </p>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- QUOTE -->

                <div class="about-quote-box">

                    <i class="fas fa-medal"></i>

                    <h4>

                        Every achievement is meaningful only when it contributes
                        to the welfare, progress and prosperity of society.

                    </h4>

                </div>

                <!-- REFERENCES -->

                <div class="about-content-card">

                    <h3>

                        References

                    </h3>

                    <ul class="reference-list">

                        <li>Public speeches and interviews</li>

                        <li>Election Commission records</li>

                        <li>Wikipedia</li>

                        <li>Publicly available newspaper reports</li>

                        <li>Official public information</li>

                    </ul>

                </div>

                <!-- PAGE NAVIGATION -->

                <div class="about-navigation">

                    <a href="@Url.Action("Vision","AboutLeader")"
                       class="about-nav-btn">

                        <i class="fas fa-arrow-left"></i>

                        Vision

                    </a>

                    <a href="@Url.Action("Timeline","AboutLeader")"
                       class="about-nav-btn">

                        Timeline

                        <i class="fas fa-arrow-right"></i>

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>

@*@Html.Partial("_JoinUs")*@