@{
    ViewBag.Title = "Biography";

    ViewBag.PageTitle = "About Sangeet Som";

    ViewBag.PageDescription = "Know more about the life, leadership journey and public service initiatives of Sangeet Som.";

    ViewBag.BannerImage = Url.Content("~/Content/User/images/banners/biography-banner.jpg");

    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

@Html.Partial("_PageBanner")

<section class="about-page-section">

    <div class="container">

        <div class="row">

            <!-- SIDEBAR -->

            <div class="col-lg-4 col-xl-3">

                @Html.Partial("_AboutLeaderSidebar")

            </div>

            <!-- CONTENT -->

            <div class="col-lg-8 col-xl-9">

                <!-- PROFILE CARD -->

                <div class="about-content-card">

                    <div class="row align-items-center">

                        <div class="col-md-4">

                            <img src="~/Content/User/images/leader/sangeet-som.jpg"
                                 class="about-leader-image img-fluid"
                                 alt="Sangeet Som" />

                        </div>

                        <div class="col-md-8">

                            <span class="about-page-badge">

                                Public Leader

                            </span>

                            <h2 class="about-page-title">

                                Sangeet Som

                            </h2>

                            <p class="about-page-text">

                                Sangeet Singh Som is a Bharatiya Janata Party politician from
                                Sardhana in Meerut district, Uttar Pradesh. He served as Member
                                of the Legislative Assembly for Sardhana from 6 March 2012 to
                                10 March 2022.

                            </p>

                            <p class="about-page-text">

                                His public profile brings together constituency outreach,
                                organisational work, election campaigns and citizen-facing
                                development priorities for western Uttar Pradesh.

                            </p>

                        </div>

                    </div>

                </div>

                <!-- QUICK FACTS -->

                <div class="about-content-card">

                    <h3>

                        Quick Profile

                    </h3>

                    <div class="row g-4">

                        <div class="col-md-6">

                            <div class="leader-fact-card">

                                <h6>
                                    Name
                                </h6>

                                <p>
                                    Sangeet Singh Som
                                </p>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="leader-fact-card">

                                <h6>
                                    Born
                                </h6>

                                <p>
                                    1 January 1978, Meerut
                                </p>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="leader-fact-card">

                                <h6>
                                    Constituency
                                </h6>

                                <p>
                                    Sardhana
                                </p>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="leader-fact-card">

                                <h6>
                                    Public Role
                                </h6>

                                <p>
                                    MLA, Sardhana (2012-2022)
                                </p>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- BIOGRAPHY -->

                <div class="about-content-card">

                    <h3>

                        Biography

                    </h3>

                    <p class="about-page-text">

                        Sangeet Som comes from the Sardhana region of Meerut district and has
                        built his public life around western Uttar Pradesh politics. Publicly
                        available profile information identifies him as a BJP leader associated
                        with the Sardhana Assembly constituency.

                    </p>

                    <p class="about-page-text">

                        Before joining the BJP, he contested the 2009 Lok Sabha election from
                        Muzaffarnagar as a Samajwadi Party candidate. He later represented
                        Sardhana in the Uttar Pradesh Legislative Assembly from 2012 to 2022.

                    </p>

                    <p class="about-page-text">

                        This page is designed as a verified public profile area for the portal:
                        it can be expanded through the CMS with approved biography notes,
                        constituency work, press material, speeches and timeline entries.

                    </p>

                </div>

                <!-- EARLY LIFE -->

                <div class="about-content-card">

                    <h3>

                        Early Life

                    </h3>

                    <p class="about-page-text">

                        Publicly available biographical information states that he was born in
                        an agricultural family in the Sardhana tehsil area of Meerut district.
                        His father is listed as Thakur Omveer Singh.

                    </p>

                    <p class="about-page-text">

                        His spouse is Preeti Som and public profile records mention two
                        children. Family and local roots can be presented here with verified
                        photographs, speeches and constituency archive material.

                    </p>

                </div>

                <!-- EDUCATION -->

                <div class="about-content-card">

                    <h3>

                        Education & Background

                    </h3>

                    <div class="row g-4">

                        <div class="col-md-4">

                            <div class="leader-info-card">

                                <i class="fas fa-graduation-cap"></i>

                                <h5>

                                    Education

                                </h5>

                                <p>

                                    Secondary education from K.K. Jain Inter College, Khatauli
                                    in 1997, as listed in public profile sources.

                                </p>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="leader-info-card">

                                <i class="fas fa-users"></i>

                                <h5>

                                    Family

                                </h5>

                                <p>

                                    Married to Preeti Som; public records mention two children.

                                </p>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="leader-info-card">

                                <i class="fas fa-briefcase"></i>

                                <h5>

                                    Profession

                                </h5>

                                <p>

                                    BJP public representative and former MLA from Sardhana.

                                </p>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- POLITICAL JOURNEY -->

                <div class="about-content-card">

                    <h3>

                        Leadership Journey

                    </h3>

                    <div class="leader-timeline">

                        <div class="timeline-item">

                            <div class="timeline-year">

                                2009

                            </div>

                            <div class="timeline-content">

                                <h5>

                                    Lok Sabha Contest

                                </h5>

                                <p>

                                    Contested the Muzaffarnagar Lok Sabha seat as a Samajwadi
                                    Party candidate and finished third.

                                </p>

                            </div>

                        </div>

                        <div class="timeline-item">

                            <div class="timeline-year">

                                2012

                            </div>

                            <div class="timeline-content">

                                <h5>

                                    Elected From Sardhana

                                </h5>

                                <p>

                                    Won the Sardhana Assembly seat and began a ten-year term
                                    in the Uttar Pradesh Legislative Assembly.

                                </p>

                            </div>

                        </div>

                        <div class="timeline-item">

                            <div class="timeline-year">

                                2017

                            </div>

                            <div class="timeline-content">

                                <h5>

                                    Continued Assembly Term

                                </h5>

                                <p>

                                    Continued public representation from Sardhana through the
                                    2017 Assembly election cycle.

                                </p>

                            </div>

                        </div>

                    </div>

                </div>
                <!-- PUBLIC SERVICE -->

                <div class="about-content-card">

                    <h3>

                        Public Service

                    </h3>

                    <div class="row g-4">

                        <div class="col-lg-4 col-md-6">

                            <div class="leader-service-card">

                                <i class="fas fa-road"></i>

                                <h5>

                                    Infrastructure

                                </h5>

                                <p>

                                    Supporting development initiatives focused on roads,
                                    connectivity and public infrastructure.

                                </p>

                            </div>

                        </div>

                        <div class="col-lg-4 col-md-6">

                            <div class="leader-service-card">

                                <i class="fas fa-school"></i>

                                <h5>

                                    Education

                                </h5>

                                <p>

                                    Encouraging educational opportunities and youth
                                    development through public participation.

                                </p>

                            </div>

                        </div>

                        <div class="col-lg-4 col-md-6">

                            <div class="leader-service-card">

                                <i class="fas fa-heartbeat"></i>

                                <h5>

                                    Healthcare

                                </h5>

                                <p>

                                    Promoting healthcare awareness and welfare initiatives
