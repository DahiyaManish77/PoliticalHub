@{
    ViewBag.Title = "Frequently Asked Questions";

    ViewBag.PageTitle = "Frequently Asked Questions";

    ViewBag.PageDescription = "Find answers to commonly asked questions about Sangeet Som, public service and leadership.";

    ViewBag.BannerImage = Url.Content("~/Content/User/images/banners/faq-banner.jpg");

    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

@Html.Partial("_PageBanner")

<section class="about-page-section">

    <div class="container">

        <div class="row">

            <div class="col-lg-4 col-xl-3">

                @Html.Partial("_AboutLeaderSidebar")

            </div>

            <div class="col-lg-8 col-xl-9">

                <div class="about-content-card">

                    <span class="about-page-badge">

                        FAQ

                    </span>

                    <h2 class="about-page-title">

                        Frequently Asked Questions

                    </h2>

                    <p class="about-page-text">

                        This section answers some of the most common questions
                        regarding Sangeet Som, public service, leadership,
                        development initiatives and community engagement.

                    </p>

                </div>

                <div class="accordion" id="faqAccordion">

                    <div class="accordion-item">

                        <h2 class="accordion-header">

                            <button class="accordion-button"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq1">

                                Who is Sangeet Som?

                            </button>

                        </h2>

                        <div id="faq1"
                             class="accordion-collapse collapse show"
                             data-bs-parent="#faqAccordion">

                            <div class="accordion-body">

                                Sangeet Som is an Indian public leader from Uttar Pradesh,
                                known for his involvement in public life,
                                constituency development and social initiatives.

                            </div>

                        </div>

                    </div>

                    <div class="accordion-item">

                        <h2 class="accordion-header">

                            <button class="accordion-button collapsed"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq2">

                                What are the major focus areas?

                            </button>

                        </h2>

                        <div id="faq2"
                             class="accordion-collapse collapse"
                             data-bs-parent="#faqAccordion">

                            <div class="accordion-body">

                                Infrastructure development,
                                education,
                                healthcare,
                                youth empowerment,
                                farmer welfare
                                and public participation.

                            </div>

                        </div>

                    </div>

                    <div class="accordion-item">

                        <h2 class="accordion-header">

                            <button class="accordion-button collapsed"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq3">

                                How can I join the organisation?

                            </button>

                        </h2>

                        <div id="faq3"
                             class="accordion-collapse collapse"
                             data-bs-parent="#faqAccordion">

                            <div class="accordion-body">

                                You can submit your application through the
                                Join Us page or register as a Volunteer.
                                Applications will be reviewed by the administration.

                            </div>

                        </div>

                    </div>

                    <div class="accordion-item">

                        <h2 class="accordion-header">

                            <button class="accordion-button collapsed"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq4">

                                How can I contact the office?

                            </button>

                        </h2>

                        <div id="faq4"
                             class="accordion-collapse collapse"
                             data-bs-parent="#faqAccordion">

                            <div class="accordion-body">

                                You can use the Contact Us page
                                to reach the office through phone,
                                email or by visiting the office address.

                            </div>

                        </div>

                    </div>

                    <div class="accordion-item">

                        <h2 class="accordion-header">

                            <button class="accordion-button collapsed"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq5">

                                Is this website officially managed?

                            </button>

                        </h2>

                        <div id="faq5"
                             class="accordion-collapse collapse"
                             data-bs-parent="#faqAccordion">

                            <div class="accordion-body">

                                This portal is intended to provide information,
                                public updates and communication with citizens.

                            </div>

                        </div>

                    </div>

                </div>

                <div class="about-content-card mt-4">

                    <h3>

                        Still Have Questions?

                    </h3>

                    <p class="about-page-text">

                        If your question is not listed above,
                        please feel free to contact our office.
                        We will be happy to assist you.

                    </p>

                    <a href="@Url.Action("Index","Contact")"
                       class="btn-contact-us">

                        Contact Us

                    </a>

                </div>

                <div class="about-navigation">

                    <a href="@Url.Action("Awards","AboutLeader")"
                       class="about-nav-btn">

                        <i class="fas fa-arrow-left"></i>

                        Awards

                    </a>

                    <a href="@Url.Action("Biography","AboutLeader")"
                       class="about-nav-btn">

                        Biography

                        <i class="fas fa-home"></i>

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>

@*@Html.Partial("_JoinUs")*@