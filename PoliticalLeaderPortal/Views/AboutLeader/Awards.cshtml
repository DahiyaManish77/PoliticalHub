@{
    ViewBag.Title = "Awards & Recognition";

    ViewBag.PageTitle = "Awards & Recognition";

    ViewBag.PageDescription = "Recognitions, honours and appreciation received during the journey of public service.";

    ViewBag.BannerImage = Url.Content("~/Content/User/images/banners/awards-banner.jpg");

    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

@Html.Partial("_PageBanner")

<section class="about-page-section">

    <div class="container">

        <div class="row">

            <div class="col-lg-4 col-xl-3">

                @Html.Partial("_AboutLeaderSidebar")

            </div>

            <div class="col-lg-8 col-xl-9">

                <!-- INTRO -->

                <div class="about-content-card">

                    <span class="about-page-badge">

                        Awards & Recognition

                    </span>

                    <h2 class="about-page-title">

                        Recognitions Earned Through Public Service

                    </h2>

                    <p class="about-page-text">

                        Recognition is a reflection of dedication,
                        leadership and commitment towards society.
                        The honours presented here represent appreciation
                        received from various organisations and institutions
                        during different stages of public life.

                    </p>

                </div>

                <!-- FEATURED AWARD -->

                <div class="featured-award-card">

                    <div class="row align-items-center">

                        <div class="col-md-4">

                            <img src="~/Content/User/images/leader/award.jpg"
                                 class="img-fluid"
                                 alt="Award">

                        </div>

                        <div class="col-md-8">

                            <span class="award-year">

                                Featured Recognition

                            </span>

                            <h3>

                                Excellence In Public Leadership

                            </h3>

                            <p>

                                This section highlights one of the most
                                important recognitions received for
                                contribution towards public welfare,
                                leadership and development initiatives.

                            </p>

                            <ul class="award-meta">

                                <li>

                                    <i class="fas fa-calendar-alt"></i>

                                    Award Year

                                </li>

                                <li>

                                    <i class="fas fa-building"></i>

                                    Awarding Organisation

                                </li>

                            </ul>

                        </div>

                    </div>

                </div>

                <!-- AWARDS GRID STARTS IN PART 2 -->
                <!--==========================================
                        AWARDS GRID
                ==========================================-->

                <div class="row g-4">

                    <div class="col-lg-6">

                        <div class="award-card">

                            <div class="award-icon">

                                <i class="fas fa-award"></i>

                            </div>

                            <h4>

                                Outstanding Public Leadership

                            </h4>

                            <span>

                                Public Service Recognition

                            </span>

                            <p>

                                Recognition for dedication towards
                                public welfare and leadership.

                            </p>

                        </div>

                    </div>

                    <div class="col-lg-6">

                        <div class="award-card">

                            <div class="award-icon">

                                <i class="fas fa-medal"></i>

                            </div>

                            <h4>

                                Community Excellence

                            </h4>

                            <span>

                                Social Organisation

                            </span>

                            <p>

                                Appreciation for continuous contribution
                                towards community development.

                            </p>

                        </div>

                    </div>

                    <div class="col-lg-6">

                        <div class="award-card">

                            <div class="award-icon">

                                <i class="fas fa-star"></i>

                            </div>

                            <h4>

                                Leadership Honour

                            </h4>

                            <span>

                                Leadership Forum

                            </span>

                            <p>

                                Recognised for leadership qualities
                                and public engagement.

                            </p>

                        </div>

                    </div>

                    <div class="col-lg-6">

                        <div class="award-card">

                            <div class="award-icon">

                                <i class="fas fa-certificate"></i>

                            </div>

                            <h4>

                                Excellence Certificate

                            </h4>

                            <span>

                                Public Institution

                            </span>

                            <p>

                                Appreciation for development initiatives
                                and public participation.

                            </p>

                        </div>

                    </div>

                    <div class="col-lg-6">

                        <div class="award-card">

                            <div class="award-icon">

                                <i class="fas fa-handshake"></i>

                            </div>

                            <h4>

                                Social Service Award

                            </h4>

                            <span>

                                NGO Recognition

                            </span>

                            <p>

                                Recognition for contribution towards
                                social welfare activities.

                            </p>

                        </div>

                    </div>

                    <div class="col-lg-6">

                        <div class="award-card">

                            <div class="award-icon">

                                <i class="fas fa-trophy"></i>

                            </div>

                            <h4>

                                Lifetime Contribution

                            </h4>

                            <span>

                                Public Appreciation

                            </span>

                            <p>

                                Honoured for continuous public service
                                and community leadership.

                            </p>

                        </div>

                    </div>

                </div>

                <!--==========================================
                        RECOGNITION SUMMARY
                ==========================================-->

                <div class="about-content-card mt-4">

                    <h3>

                        Recognition & Appreciation

                    </h3>

                    <p class="about-page-text">

                        Awards and recognitions represent appreciation
                        received for leadership, public service,
                        community participation and development-oriented
                        initiatives.

                    </p>

                </div>

                <!-- PART 3 STARTS HERE -->
                <!--==========================================
                    RECOGNITION TIMELINE
                ===========================================-->

                <div class="about-content-card">

                    <h3>

                        Recognition Journey

                    </h3>

                    <div class="leader-timeline">

                        <div class="timeline-item">

                            <div class="timeline-year">

                                2012

                            </div>

                            <div class="timeline-content">

                                <h5>

                                    Public Appreciation

                                </h5>

                                <p>

                                    Recognition for active participation
                                    in public service and constituency
                                    development initiatives.

                                </p>

                            </div>

                        </div>

                        <div class="timeline-item">

                            <div class="timeline-year">

                                2017

                            </div>

                            <div class="timeline-content">

                                <h5>

                                    Leadership Recognition

                                </h5>

                                <p>

                                    Appreciation received for leadership,
                                    public outreach and citizen engagement.

                                </p>

                            </div>

                        </div>

                        <div class="timeline-item">

                            <div class="timeline-year">

                                Present

                            </div>

                            <div class="timeline-content">

                                <h5>

                                    Continuing Public Service

                                </h5>

                                <p>

                                    Continuing commitment towards
                                    development, public welfare and
                                    social responsibility.

                                </p>

                            </div>

                        </div>

                    </div>

                </div>

                <!--==========================================
                    QUOTATION
                ===========================================-->

                <div class="about-quote-box">

                    <i class="fas fa-award"></i>

                    <h4>

                        The greatest honour is the trust and
                        confidence of the people. Every recognition
                        inspires greater responsibility towards
                        public service.

                    </h4>

                </div>

                <!--==========================================
                    REFERENCES
                ===========================================-->

                <div class="about-content-card">

                    <h3>

                        References

                    </h3>

                    <p class="about-page-text">

                        This page is intended to present recognitions
                        received during public life. Information can
                        be updated as verified records become available.

                    </p>

                    <ul class="reference-list">

                        <li>

                            Publicly available news reports

                        </li>

                        <li>

                            Public speeches and interviews

                        </li>

                        <li>

                            Official public information

                        </li>

                        <li>

                            Election Commission records

                        </li>

                        <li>

                            Wikipedia

                        </li>

                    </ul>

                </div>

                <!--==========================================
                    PAGE NAVIGATION
                ===========================================-->

                <div class="about-navigation">

                    <a href="@Url.Action("Timeline","AboutLeader")"
                       class="about-nav-btn">

                        <i class="fas fa-arrow-left"></i>

                        Timeline

                    </a>

                    <a href="@Url.Action("Faq","AboutLeader")"
                       class="about-nav-btn">

                        FAQ

                        <i class="fas fa-arrow-right"></i>

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>

@*@Html.Partial("_JoinUs")*@
