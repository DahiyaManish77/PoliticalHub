@{
    ViewBag.Title = "Timeline";

    ViewBag.PageTitle = "Political Timeline";

    ViewBag.PageDescription = "A journey of public service, leadership, development initiatives and community engagement.";

    ViewBag.BannerImage = Url.Content("~/Content/User/images/banners/timeline-banner.jpg");

    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

@Html.Partial("_PageBanner")

<section class="about-page-section">

    <div class="container">

        <div class="row">

            <!-- SIDEBAR -->

            <div class="col-lg-4 col-xl-3">

                @Html.Partial("_AboutLeaderSidebar")

            </div>

            <!-- MAIN CONTENT -->

            <div class="col-lg-8 col-xl-9">

                <!-- HERO SECTION -->

                <div class="timeline-hero-card">

                    <div class="row align-items-center">

                        <div class="col-lg-4">

                            <div class="timeline-hero-image">

                                <img src="~/Content/User/images/leader/sangeet-som.jpg"
                                     alt="Sangeet Som"
                                     class="img-fluid" />

                            </div>

                        </div>

                        <div class="col-lg-8">

                            <span class="about-page-badge">

                                Leadership Journey

                            </span>

                            <h2 class="timeline-hero-title">

                                The Journey Of Public Leadership

                            </h2>

                            <p class="timeline-hero-text">

                                A factual timeline of public milestones, election activity
                                and constituency representation based on publicly available
                                profile information.

                            </p>

                            <div class="timeline-stats">

                                <div class="timeline-stat-box">

                                    <h4>

                                        10

                                    </h4>

                                    <span>

                                        Years As MLA

                                    </span>

                                </div>

                                <div class="timeline-stat-box">

                                    <h4>

                                        2012

                                    </h4>

                                    <span>

                                        First Assembly Win

                                    </span>

                                </div>

                                <div class="timeline-stat-box">

                                    <h4>

                                        Sardhana

                                    </h4>

                                    <span>

                                        Constituency

                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- INTRODUCTION -->

                <div class="about-content-card">

                    <h3>

                        Leadership Timeline

                    </h3>

                    <p class="about-page-text">

                        This timeline gives visitors a quick, structured view of Sangeet
                        Som's public profile. The CMS can later add richer entries with
                        photographs, campaign documents, speeches and press releases.

                    </p>

                    <p class="about-page-text">

                        Dates below are drawn from public profile records and should be
                        verified by the content team before formal campaign publication.

                    </p>

                </div>

                <!-- TIMELINE STARTS IN PART 2 -->
                <!--====================================================
                        LEADERSHIP TIMELINE
                =====================================================-->

                <div class="leader-timeline-wrapper">

                    <!-- ITEM -->

                    <div class="leader-timeline-item">

                        <div class="leader-timeline-year">

                            1978

                        </div>

                        <div class="leader-timeline-content">

                            <span class="timeline-badge">

                                Early Life

                            </span>

                            <h4>

                                Born In Meerut

                            </h4>

                            <p>

                                Born on 1 January 1978 in Meerut district, Uttar Pradesh.

                            </p>

                        </div>

                    </div>

                    <!-- ITEM -->

                    <div class="leader-timeline-item">

                        <div class="leader-timeline-year">

                            2009

                        </div>

                        <div class="leader-timeline-content">

                            <span class="timeline-badge">

                                Election

                            </span>

                            <h4>

                                Muzaffarnagar Lok Sabha Contest

                            </h4>

                            <p>

                                Contested from Muzaffarnagar as a Samajwadi Party candidate
                                and finished third.

                            </p>

                        </div>

                    </div>

                    <!-- ITEM -->

                    <div class="leader-timeline-item">

                        <div class="leader-timeline-year">

                            2012

                        </div>

                        <div class="leader-timeline-content">

                            <span class="timeline-badge">

                                Public Office

                            </span>

                            <h4>

                                Elected MLA From Sardhana

                            </h4>

                            <p>

                                Elected to the Uttar Pradesh Legislative Assembly from the
                                Sardhana constituency.

                            </p>

                        </div>

                    </div>

                    <!-- ITEM -->

                    <div class="leader-timeline-item">

                        <div class="leader-timeline-year">

                            2017

                        </div>

                        <div class="leader-timeline-content">

                            <span class="timeline-badge">

                                Assembly

                            </span>

                            <h4>

                                Continued Sardhana Representation

                            </h4>

                            <p>

                                Continued his public representative role through the next
                                Assembly term from Sardhana.

                            </p>

                        </div>

                    </div>

                    <!-- ITEM -->

                    <div class="leader-timeline-item">

                        <div class="leader-timeline-year">

                            2022

                        </div>

                        <div class="leader-timeline-content">

                            <span class="timeline-badge">

                                Transition

                            </span>

                            <h4>

                                Assembly Term Completed

                            </h4>

                            <p>

                                Completed his Assembly tenure on 10 March 2022; the Sardhana
                                seat was subsequently represented by Atul Pradhan.

                            </p>

                        </div>

                    </div>

                    <!-- ITEM -->

                    <div class="leader-timeline-item">

                        <div class="leader-timeline-year">

                            Present

                        </div>

                        <div class="leader-timeline-content">

                            <span class="timeline-badge">

                                Organisation

                            </span>

                            <h4>

                                Public Outreach

                            </h4>

                            <p>

                                Continues public outreach, political communication and
                                organisational activity in the region.

                            </p>

                        </div>

                    </div>

                    <!-- ITEM -->

                    <div class="leader-timeline-item">

                        <div class="leader-timeline-year">

                            CMS

                        </div>

                        <div class="leader-timeline-content">

                            <span class="timeline-badge">

                                Next Step

                            </span>

                            <h4>

                                Dynamic Timeline

                            </h4>

                            <p>

                                Add verified campaign events, media links, manifesto points
                                and constituency milestones through the admin panel.

                            </p>

                        </div>

                    </div>

                </div>

                <!-- TIMELINE CONTINUES IN PART 3 -->
                <!--==========================================
                    LEADERSHIP PHILOSOPHY
                ===========================================-->

                <div class="about-content-card">

                    <h3>

                        Leadership Philosophy

                    </h3>

                    <p class="about-page-text">

                        Leadership is built on responsibility, transparency,
                        accountability and continuous engagement with citizens.
                        Every initiative should contribute towards development,
                        social harmony and public welfare.

                    </p>

                </div>

                <!--==========================================
                    LEADERSHIP PRINCIPLES
                ===========================================-->

                <div class="row g-4 mb-4">

                    <div class="col-lg-6">

                        <div class="leader-info-card">

                            <i class="fas fa-users"></i>

                            <h5>

                                People First

                            </h5>

                            <p>

                                Listening to public concerns and encouraging
                                citizen participation in development.

                            </p>

                        </div>

                    </div>

                    <div class="col-lg-6">

                        <div class="leader-info-card">

                            <i class="fas fa-handshake"></i>

                            <h5>

                                Honest Leadership

                            </h5>

                            <p>

                                Building trust through transparency,
                                accountability and public service.

                            </p>

                        </div>

                    </div>

                    <div class="col-lg-6">

                        <div class="leader-info-card">

                            <i class="fas fa-city"></i>

                            <h5>

                                Sustainable Development

                            </h5>

                            <p>

                                Supporting infrastructure, education,
                                healthcare and long-term regional growth.

                            </p>

                        </div>

                    </div>

                    <div class="col-lg-6">

                        <div class="leader-info-card">

                            <i class="fas fa-lightbulb"></i>

                            <h5>

                                Innovation

                            </h5>

                            <p>

                                Promoting technology-driven governance
                                and efficient public services.

                            </p>

                        </div>

                    </div>

                </div>

                <!--==========================================
                    PUBLIC SERVICE HIGHLIGHTS
                ===========================================-->

                <div class="about-content-card">

                    <h3>

                        Public Service Highlights

                    </h3>

                    <div class="row g-4">

                        <div class="col-md-6">

                            <div class="leader-fact-card">

                                <h6>

                                    Infrastructure Development

                                </h6>

                                <p>

                                    Supporting projects related to roads,
                                    public buildings and civic facilities.

                                </p>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="leader-fact-card">

                                <h6>

                                    Youth Engagement

                                </h6>

                                <p>

                                    Encouraging youth participation in
                                    leadership, education and nation building.

                                </p>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="leader-fact-card">

                                <h6>

                                    Community Outreach

                                </h6>

                                <p>

                                    Regular interaction with citizens through
                                    meetings and public programmes.

                                </p>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="leader-fact-card">

                                <h6>

                                    Welfare Initiatives

                                </h6>

                                <p>

                                    Supporting initiatives focused on
                                    education, healthcare and rural development.

                                </p>

                            </div>

                        </div>

                    </div>

                </div>

                <!--==========================================
                    TIMELINE SUMMARY
                ===========================================-->

                <div class="about-content-card">

                    <h3>

                        Journey At A Glance

                    </h3>

                    <p class="about-page-text">

                        From public interaction to leadership responsibilities,
                        the journey has been driven by continuous engagement
                        with citizens and participation in development-oriented
                        initiatives. Every phase has contributed towards
                        strengthening public service and community welfare.

                    </p>

                </div>

                <!--==========================================
                    QUOTATION
                ===========================================-->

                <div class="about-quote-box">

                    <i class="fas fa-quote-left"></i>

                    <h4>

                        Leadership is not measured by position,
                        but by the positive impact created in the
                        lives of people through service and commitment.

                    </h4>

                </div>

                <!-- TIMELINE CONTINUES IN PART 4 -->
                <!--==========================================
                    REFERENCES
                ===========================================-->

                <div class="about-content-card">

                    <h3>

                        References

                    </h3>

                    <p class="about-page-text">

                        This timeline has been prepared using publicly available
                        information. It is intended to present an overview of
                        leadership and public service activities and may be
                        updated as additional verified information becomes
                        available.

                    </p>

                    <ul class="reference-list">

                        <li>

                            Wikipedia - Sangeet Singh Som

                        </li>

                        <li>

                            Election Commission of India

                        </li>

                        <li>

                            MyNeta Candidate Information

                        </li>

                        <li>

                            Public speeches & interviews

                        </li>

                        <li>

                            National & Regional Newspaper Reports

                        </li>

                    </ul>

                </div>

                <!--==========================================
                    NEXT / PREVIOUS
                ===========================================-->

                <div class="about-navigation">

                    <a href="@Url.Action("Achievements","AboutLeader")"
                       class="about-nav-btn">

                        <i class="fas fa-arrow-left"></i>

                        Achievements

                    </a>

                    <a href="@Url.Action("Awards","AboutLeader")"
                       class="about-nav-btn">

                        Awards

                        <i class="fas fa-arrow-right"></i>

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>

@*@Html.Partial("_JoinUs")*@
