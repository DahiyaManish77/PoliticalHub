@model PoliticalLeaderPortal.ViewModels.PublicGalleryAlbumVM

@{
    ViewBag.Title = Model.CategoryName;
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.4/css/lightbox.min.css"
      rel="stylesheet" />

<section class="gallery-album-header">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <span class="gallery-badge">

                    Photo Album

                </span>

                <h1 class="album-title">

                    @Model.CategoryName

                </h1>

                <p class="album-description">

                    @Model.CategoryDescription

                </p>

            </div>

            <div class="col-lg-4 text-lg-end">

                <a href="@Url.Action("Index","Gallery")"
                   class="btn-back-gallery">

                    <i class="bi bi-arrow-left"></i>
                    Back To Gallery

                </a>

            </div>

        </div>

    </div>

</section>

<section class="album-gallery-section">

    <div class="container">

        @if (Model.Images != null && Model.Images.Any())
        {
            <div class="row g-4">

                @foreach (var image in Model.Images)
                {
                    var imagePath = Url.Content(image.ImagePath);
                    var imageTitle = string.IsNullOrWhiteSpace(image.ImageTitle)
                        ? "Gallery Image"
                        : image.ImageTitle;

                    <div class="col-xl-3 col-lg-4 col-md-6">

                        <div class="album-image-card">

                            <a href="@imagePath"
                               data-lightbox="gallery"
                               data-title="@imageTitle">

                                <img src="@imagePath"
                                     alt="@imageTitle"
                                     class="album-image" />

                            </a>

                            <div class="album-image-content">

                                <h6>

                                    @imageTitle

                                </h6>

                                @if (!string.IsNullOrWhiteSpace(image.ImageCaption))
                                {
                                    <p>

                                        @(image.ImageCaption.Length > 80
                                            ? image.ImageCaption.Substring(0, 80) + "..."
                                            : image.ImageCaption)

                                    </p>
                                }

                                <div class="album-image-actions"
                                     data-public-actions
                                     data-item-type="gallery"
                                     data-item-id="@image.GalleryImageId"
                                     data-title="@imageTitle"
                                     data-url="@imagePath">
                                    <button type="button" data-action="like" aria-label="Like image">
                                        <i class="bi bi-hand-thumbs-up"></i>
                                        <small data-like-count>0</small>
                                    </button>
                                    <button type="button" data-action="comment" aria-label="Comment on image">
                                        <i class="bi bi-chat-dots"></i>
                                    </button>
                                    <button type="button" data-action="share" aria-label="Share image">
                                        <i class="bi bi-share"></i>
                                    </button>
                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="alert alert-info text-center">

                No Images Available In This Album.

            </div>
        }

    </div>

</section>

@section scripts{

    <script src="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.4/js/lightbox.min.js"></script>

    <script>

        lightbox.option({
            resizeDuration: 200,
            wrapAround: true,
            fadeDuration: 300,
            imageFadeDuration: 300
        });

    </script>

}

<style>

    .gallery-album-header {
        background: linear-gradient(135deg, #0f172a, #172033);
        padding: 30px 0;
        color: #ffffff;
        border-bottom: 1px solid rgba(255,255,255,.08);
    }

    .gallery-badge {
        display: inline-block;
        background: #ff9933;
        color: #ffffff;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 600;
        line-height: 1.2;
        margin-bottom: 10px;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .album-title {
        font-size: clamp(1.45rem, 2.4vw, 2.15rem);
        font-weight: 800;
        line-height: 1.08;
        margin-bottom: 6px;
    }

    .album-description {
        font-size: .96rem;
        color: rgba(255,255,255,.85);
        max-width: 720px;
        margin-bottom: 0;
        line-height: 1.5;
    }

    .btn-back-gallery {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #ff9933;
        color: #ffffff;
        text-decoration: none;
        padding: 10px 18px;
        border-radius: 8px;
        font-weight: 600;
        font-size: .95rem;
        box-shadow: 0 10px 22px rgba(255,153,51,.22);
        transition: transform .2s ease, box-shadow .2s ease, background-color .2s ease;
    }

    .btn-back-gallery:hover {
        background: #f58b1f;
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 12px 26px rgba(255,153,51,.28);
    }

    .album-gallery-section {
        padding: 36px 0 52px;
        background: #f8fafc;
    }

    .album-image-card {
        background: #ffffff;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid rgba(15,23,42,.07);
        box-shadow: 0 8px 20px rgba(15,23,42,.07);
        transition: all .3s ease;
        height: 100%;
    }

    .album-image-card:hover {
        transform: translateY(-5px);
    }

    .album-image {
        width: 100%;
        height: 230px;
        object-fit: cover;
        transition: .4s ease;
    }

    .album-image-card:hover .album-image {
        transform: scale(1.05);
    }

    .album-image-content {
        padding: 12px 14px 14px;
    }

    .album-image-content h6 {
        font-weight: 700;
        margin-bottom: 6px;
        color: #0f172a;
        font-size: .98rem;
        line-height: 1.3;
    }

    .album-image-content p {
        color: #64748b;
        margin-bottom: 10px;
        font-size: 13px;
        line-height: 1.45;
    }

    .album-image-actions {
        display: flex;
        gap: 7px;
        margin-top: 10px;
    }

    .album-image-actions button {
        display: inline-grid;
        grid-auto-flow: column;
        place-items: center;
        gap: 4px;
        min-width: 34px;
        height: 32px;
        border: 1px solid #dbe4f0;
        border-radius: 999px;
        color: #22304a;
        background: #ffffff;
        font-size: 12px;
        font-weight: 800;
        transition: background .2s ease, color .2s ease, border-color .2s ease, transform .2s ease;
    }

    .album-image-actions button:hover,
    .album-image-actions button.is-liked {
        color: #fff;
        border-color: #ff9933;
        background: #ff7a1a;
        transform: translateY(-1px);
    }

    .album-image-actions small {
        font-size: 11px;
        font-weight: 900;
    }

    @@media (max-width:991px) {

        .album-title {
            font-size: 1.75rem;
        }

    }

    @@media (max-width:767px) {

        .gallery-album-header {
            padding: 24px 0;
        }

        .album-title {
            font-size: 1.45rem;
        }

        .album-gallery-section {
            padding: 26px 0 40px;
        }

        .album-image {
            height: 210px;
        }

        .btn-back-gallery {
            margin-top: 16px;
            width: 100%;
            justify-content: center;
        }

    }

</style>
