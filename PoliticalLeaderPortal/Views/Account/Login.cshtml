@model PoliticalLeaderPortal.ViewModels.AccountLoginVM

@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

@section Styles {
    <link href="~/Content/css/account.css" rel="stylesheet" />
}

<section class="account-page">
    <div class="account-shell">
        <aside class="account-panel">
            <small>Public Leadership Portal</small>
            <h1>Welcome back</h1>
            <p>Access your public portal account, save preferences and stay connected with constituency updates.</p>
            <ul class="account-list">
                <li><i class="bi bi-shield-check"></i><span>Secure account access</span></li>
                <li><i class="bi bi-newspaper"></i><span>News, events and public updates</span></li>
                <li><i class="bi bi-people"></i><span>Citizen connect features ready for expansion</span></li>
            </ul>
        </aside>

        <div class="account-card">
            <h2>Login</h2>
            <p class="account-muted">Use your registered email address and password.</p>

            @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { area = "" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ReturnUrl)

                @Html.ValidationSummary(true, "", new { @class = "account-validation" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.EmailAddress, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.EmailAddress, new { @class = "form-control", type = "email", autocomplete = "email" })
                    @Html.ValidationMessageFor(m => m.EmailAddress, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "current-password" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                </div>

                <div class="form-check mb-4">
                    @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input" })
                    @Html.LabelFor(m => m.RememberMe, new { @class = "form-check-label" })
                </div>

                <button type="submit" class="account-action">Login</button>
            }

            <p class="account-switch">
                New here?
                <a href="@Url.Action("Register", "Account", new { area = "" })">Create an account</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
}
