@model PoliticalLeaderPortal.Areas.Admin.ViewModels.PublicDocumentVerificationVM
@{ ViewBag.Title="Document verification"; var color=Model.IsValid?"#107c10":"#c50f1f"; }
<style>
.verify-shell{max-width:760px;margin:64px auto;padding:0 20px;font-family:"Segoe UI Variable","Segoe UI",sans-serif}.verify-card{background:#fff;border:1px solid #e5e7eb;border-radius:18px;box-shadow:0 14px 40px rgba(16,24,40,.1);overflow:hidden}.verify-head{padding:28px 32px;color:#fff;background:@color}.verify-body{padding:32px}.verify-state{font-size:22px;font-weight:650}.verify-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:24px}.verify-field span{display:block;color:#667085;font-size:12px;text-transform:uppercase}.verify-field strong{display:block;margin-top:5px;color:#101828}.verify-note{margin-top:28px;background:#f8fafc;border-radius:10px;padding:14px;color:#475467;font-size:13px}@@media(max-width:600px){.verify-grid{grid-template-columns:1fr}}
</style>
<main class="verify-shell"><section class="verify-card"><header class="verify-head"><div style="display:flex;align-items:center;gap:14px"><img src="@Url.Content("~/Content/images/leader.png")" alt="Sangeet Som" style="width:54px;height:54px;border-radius:50%;object-fit:cover;border:2px solid rgba(255,255,255,.85)" /><div><div style="font-size:18px;font-weight:650">SANGEET SOM</div><div style="font-size:12px;opacity:.85">CAMPAIGN OFFICE · OFFICIAL VERIFICATION</div></div></div><div class="verify-state" style="margin-top:14px">@(Model.IsValid?"✓":"!") @Model.VerificationState</div></header><div class="verify-body">
@if(!Model.Found){<h2>Document not found</h2><p>This code does not match an issued document. Check the QR code or contact the campaign office.</p>}
else{<h2>@Model.DocumentNumber</h2><div class="verify-grid">
<div class="verify-field"><span>Document</span><strong>@Model.DocumentType</strong></div><div class="verify-field"><span>Recipient</span><strong>@Model.RecipientName</strong></div>
<div class="verify-field"><span>Reference</span><strong>@(Model.RecipientReference??"—")</strong></div><div class="verify-field"><span>Role</span><strong>@(Model.RecipientRole??"—")</strong></div>
<div class="verify-field"><span>Campaign</span><strong>@(Model.CampaignName??"Organization-wide")</strong></div><div class="verify-field"><span>Issue date</span><strong>@Model.IssueDate.Value.ToString("dd MMM yyyy")</strong></div>
<div class="verify-field"><span>Valid until</span><strong>@(Model.ExpiryDate.HasValue?Model.ExpiryDate.Value.ToString("dd MMM yyyy"):"No expiry")</strong></div><div class="verify-field"><span>Issued by</span><strong>@(Model.IssuedByName??"Authorized campaign office")</strong></div>
</div>if(!String.IsNullOrWhiteSpace(Model.Subject)){<div class="verify-note"><strong>Subject:</strong> @Model.Subject</div>}<div class="verify-note">Only verification-safe information is displayed. Phone and address details are never published.</div>}
</div></section></main>
