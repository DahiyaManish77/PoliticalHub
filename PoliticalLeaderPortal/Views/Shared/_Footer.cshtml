@model PoliticalLeaderPortal.ViewModels.LayoutFooterVM
@if (Model != null && Model.IsActive)
{
<footer class="campaign-footer" id="contact-section">
    <div class="campaign-footer-grid">
        <div>
            <div class="campaign-footer-logo">Sangeet Som</div>
            <p class="campaign-footer-tagline">@Model.AboutText</p>
            <p class="campaign-footer-disclaimer">Official public communication and constituency engagement portal.</p>
        </div>
        <div class="campaign-footer-column">
            <h4>Quick links</h4>
            <a href="@Url.Action("Index","AboutLeader")">About us</a>
            <a href="@Url.Action("Index","AboutLeader")">Meet the leader</a>
            <a href="@Url.Action("Index","News")">Our platform</a>
            <a href="#">Privacy policy</a>
            <a href="#">Accessibility</a>
        </div>
        <div class="campaign-footer-column">
            <h4>Get involved</h4>
            <a href="@Url.Action("Index","Event")">Upcoming events</a>
            <a href="#get-involved">Volunteer portal</a>
            <a href="#get-involved">Become a member</a>
            <a href="#get-involved">Careers</a>
            <a href="#get-involved">Donate now</a>
        </div>
        <div class="campaign-footer-column">
            <h4>Stay updated</h4>
            <p>Get constituency updates in your inbox, about once a week.</p>
            <form class="campaign-newsletter" action="#" method="post">
                <input type="email" placeholder="Enter your email address" aria-label="Email address" />
                <button type="submit">Subscribe</button>
            </form>
        </div>
    </div>
    <div class="campaign-footer-bottom">
        <div class="campaign-social-row">
            @if (!String.IsNullOrWhiteSpace(Model.FacebookUrl)) { <a href="@Model.FacebookUrl" target="_blank"><i class="bi bi-facebook"></i></a> }
            @if (!String.IsNullOrWhiteSpace(Model.TwitterUrl)) { <a href="@Model.TwitterUrl" target="_blank"><i class="bi bi-twitter-x"></i></a> }
            @if (!String.IsNullOrWhiteSpace(Model.InstagramUrl)) { <a href="@Model.InstagramUrl" target="_blank"><i class="bi bi-instagram"></i></a> }
            @if (!String.IsNullOrWhiteSpace(Model.YoutubeUrl)) { <a href="@Model.YoutubeUrl" target="_blank"><i class="bi bi-youtube"></i></a> }
        </div>
        <div class="campaign-copyright">@(String.IsNullOrWhiteSpace(Model.CopyrightText) ? "© " + DateTime.Now.Year + " Sangeet Som. All rights reserved." : Model.CopyrightText)</div>
    </div>
</footer>
}
