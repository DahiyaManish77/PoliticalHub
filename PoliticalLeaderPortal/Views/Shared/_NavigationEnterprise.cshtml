@using PoliticalLeaderPortal.Areas.Admin.ViewModels.Menu
@using System.Web.Routing
@using System.Linq
@model List<MenuVM>
@functions {
    private RouteValueDictionary RouteValues(MenuVM menu) {
        var values = new RouteValueDictionary();
        values["area"] = String.IsNullOrWhiteSpace(menu.AreaName) ? "" : menu.AreaName.Trim();
        return values;
    }
    private string MenuUrl(MenuVM menu) {
        if (!String.IsNullOrWhiteSpace(menu.CustomUrl)) return menu.CustomUrl;
        if (!String.IsNullOrWhiteSpace(menu.ControllerName) && !String.IsNullOrWhiteSpace(menu.ActionName))
            return Url.Action(menu.ActionName.Trim(), menu.ControllerName.Trim(), RouteValues(menu));
        return "#";
    }
}
@{
    var items = Model == null ? new List<MenuVM>() : Model.OrderBy(x => x.DisplayOrder).Take(7).ToList();
}
<nav class="campaign-navbar" aria-label="Main navigation">
  <div class="campaign-navbar-inner">
    <a class="campaign-brand" href="@Url.Action("Index", "Home", new { area = "" })">
        <span class="campaign-brand-mark"><img src="@Url.Content("~/Content/images/logo.png")" alt="" /></span>
        <span>Sangeet Som</span>
    </a>
    <button class="campaign-mobile-menu" type="button" aria-controls="campaignNavLinks" aria-expanded="false"><i class="bi bi-list"></i></button>
    <div class="campaign-nav-links" id="campaignNavLinks">
        @if (items.Any()) {
            foreach (var item in items) {
                <a href="@MenuUrl(item)" target="@(item.OpenInNewTab ? "_blank" : "_self")">@item.MenuName</a>
            }
        } else {
            <a class="active" href="@Url.Action("Index", "Home")">Home</a>
            <a href="@Url.Action("Index", "AboutLeader")">About us</a>
            <a href="#get-involved">Issues</a>
            <a href="#gallery">Media &amp; news</a>
            <a href="#videos">Events</a>
            <a href="#get-involved">Get involved <span aria-hidden="true">▾</span></a>
            <a href="#contact-section">Contact</a>
        }
    </div>
    <div class="campaign-nav-actions">
        <a class="campaign-nav-button campaign-nav-button-gold" href="#get-involved">Join us</a>
    </div>
  </div>
</nav>
