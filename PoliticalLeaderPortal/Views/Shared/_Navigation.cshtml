@using PoliticalLeaderPortal.Areas.Admin.ViewModels.Menu
@using System.Web.Routing
@model List<MenuVM>

@functions
{
    private RouteValueDictionary ParseRouteValues(MenuVM menu)
    {
        var values = new RouteValueDictionary();

        if (!string.IsNullOrWhiteSpace(menu.AreaName))
        {
            values["area"] = menu.AreaName.Trim();
        }

        if (string.IsNullOrWhiteSpace(menu.RouteValues))
        {
            return values;
        }

        var pairs = menu.RouteValues.Split('&');

        foreach (var pair in pairs)
        {
            var parts = pair.Split('=');

            if (parts.Length == 2 &&
                !string.IsNullOrWhiteSpace(parts[0]))
            {
                values[parts[0].Trim()] = parts[1].Trim();
            }
        }

        return values;
    }

    private string GetMenuUrl(MenuVM menu)
    {
        if (!string.IsNullOrWhiteSpace(menu.CustomUrl))
        {
            return menu.CustomUrl;
        }

        if (!string.IsNullOrWhiteSpace(menu.ControllerName) &&
            !string.IsNullOrWhiteSpace(menu.ActionName))
        {
            return Url.Action(
                menu.ActionName.Trim(),
                menu.ControllerName.Trim(),
                ParseRouteValues(menu));
        }

        return "#";
    }
}

@helper RenderMegaColumn(MenuVM menu)
{
    string menuUrl = GetMenuUrl(menu);
    string target = menu.OpenInNewTab ? "_blank" : "_self";
    string rel = menu.OpenInNewTab ? "noopener noreferrer" : "";
    bool isClickable = menu.IsClickable && menuUrl != "#";

    <section class="site-mega-column @menu.CssClass">

        <a href="@(isClickable ? menuUrl : "#")"
           class="site-mega-heading"
           target="@target"
           rel="@rel">
            @menu.MenuName
        </a>

        @if (menu.Children != null && menu.Children.Any())
        {
            <ul class="site-mega-links">

                @foreach (var child in menu.Children)
                {
                    string childUrl = GetMenuUrl(child);
                    string childTarget = child.OpenInNewTab ? "_blank" : "_self";
                    string childRel = child.OpenInNewTab ? "noopener noreferrer" : "";
                    bool childClickable = child.IsClickable && childUrl != "#";

                    <li>

                        <a href="@(childClickable ? childUrl : "#")"
                           target="@childTarget"
                           rel="@childRel">
                            @child.MenuName
                        </a>

                    </li>
                }

            </ul>
        }

    </section>
}

