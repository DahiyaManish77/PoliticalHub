@model List<PoliticalLeaderPortal.ViewModels.UpcomingEventListVM>
@{
    Layout = null;
    var events = Model ?? new List<PoliticalLeaderPortal.ViewModels.UpcomingEventListVM>();
}
<section class="campaign-showcase campaign-events-showcase" id="events">
    <div class="campaign-showcase-head">
        <div>
            <span class="campaign-kicker">UPCOMING EVENTS</span>
            <h2>Meet us on the ground</h2>
            <p>Public meetings, Jan Sampark programmes and constituency activities.</p>
        </div>
        <a class="campaign-explore" href="@Url.Action("Index", "Event")">View all events <i class="bi bi-arrow-up-right"></i></a>
    </div>
    @if (events.Any())
    {
        <div class="campaign-event-line" aria-hidden="true"></div>
        <div class="campaign-event-track">
            @foreach (var item in events)
            {
                var image = String.IsNullOrWhiteSpace(item.EventImagePath) ? Url.Content("~/Content/images/event-placeholder.jpg") : Url.Content(item.EventImagePath);
                <article class="campaign-event-card">
                    <span class="campaign-event-clip" aria-hidden="true"></span>
                    <a class="campaign-event-image" href="@Url.Action("Details", "Event", new { id = item.EventId })">
                        <img src="@image" alt="@item.Title" loading="lazy" />
                        <time datetime="@item.EventDate.ToString("yyyy-MM-dd")"><strong>@item.EventDate.ToString("dd")</strong><span>@item.EventDate.ToString("MMM").ToUpper()</span></time>
                    </a>
                    <div class="campaign-event-copy">
                        <h3><a href="@Url.Action("Details", "Event", new { id = item.EventId })">@item.Title</a></h3>
                        <p>
                            @if (!String.IsNullOrWhiteSpace(item.EventTime)) { <span><i class="bi bi-clock"></i> @item.EventTime</span> }
                            @if (!String.IsNullOrWhiteSpace(item.EventLocation)) { <span><i class="bi bi-geo-alt"></i> @item.EventLocation</span> }
                        </p>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        var placeholders = new[]
        {
            new { Title = "Jan Sampark Programme", Location = "Constituency programme", Image = "~/Uploads/Gallery/Images/00e5f64e-cf31-4c0e-84c0-13667faf57ac.jpg" },
            new { Title = "Public Meeting", Location = "Venue to be announced", Image = "~/Uploads/Gallery/Images/3a298230-ca24-4844-b773-1938908044f6.jpg" },
            new { Title = "Youth Dialogue", Location = "Schedule coming soon", Image = "~/Uploads/Gallery/Images/3be79d89-5bfb-4437-8501-8ad14e32c42c.jpg" },
            new { Title = "Community Outreach", Location = "Details to be announced", Image = "~/Uploads/Gallery/Images/3cf3085e-19b4-4c27-b9f3-d5af176fa68f.jpg" }
        };
        <div class="campaign-event-line" aria-hidden="true"></div>
        <div class="campaign-event-track campaign-event-placeholders">
            @foreach (var item in placeholders)
            {
                <article class="campaign-event-card is-placeholder">
                    <span class="campaign-event-clip" aria-hidden="true"></span>
                    <a class="campaign-event-image" href="@Url.Action("Index", "Event")">
                        <img src="@Url.Content(item.Image)" alt="" loading="lazy" />
                        <span class="campaign-event-coming"><i class="bi bi-calendar-event"></i> Coming soon</span>
                    </a>
                    <div class="campaign-event-copy">
                        <h3><a href="@Url.Action("Index", "Event")">@item.Title</a></h3>
                        <p><span><i class="bi bi-geo-alt"></i> @item.Location</span></p>
                    </div>
                </article>
            }
        </div>
        <p class="campaign-event-placeholder-note"><i class="bi bi-info-circle"></i> Programme dates and venues will appear here after they are announced.</p>
    }
</section>
