@model PoliticalLeaderPortal.ViewModels.Poll.PublicPollVM
@using System.Linq
@{
    Layout = null;
    var hasPoll = Model != null;
    var publicUrl = hasPoll ? Url.Action("Details", "Poll", new { slug = Model.PublicSlug, source = "home" }) : "#";
    var daysLeft = hasPoll && Model.EndDate.HasValue ? Math.Max(0, (Model.EndDate.Value.Date - DateTime.Today).Days) : 0;
}
@if (hasPoll)
{
    <section class="campaign-poll-showcase" id="poll">
        <div class="campaign-poll-shell">
            <div class="campaign-poll-intro">
                <span class="campaign-kicker">POLL &amp; SURVEY</span>
                <h2>Your voice shapes our priorities.</h2>
                <p>Take a moment to share your view on the issues that matter to our constituency.</p>
                <a class="campaign-explore campaign-explore-light" href="@publicUrl">Explore poll <i class="bi bi-arrow-up-right"></i></a>
            </div>
            @using (Html.BeginForm("Vote", "Poll", FormMethod.Post, new { @class = "campaign-poll-panel" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="PollId" value="@Model.PollId" />
                <input type="hidden" name="PublicSlug" value="@Model.PublicSlug" />
                <input type="hidden" name="Source" value="home" />
                <input type="hidden" name="ConsentGiven" value="true" />
                <span class="campaign-poll-badge">Live public poll</span>
                <h3>@Model.Question</h3>
                <div class="campaign-poll-options">
                    @foreach (var option in Model.Options.Take(5))
                    {
                        <label>
                            <input type="radio" name="PollOptionId" value="@option.PollOptionId" required />
                            <span class="campaign-poll-radio"><i class="bi bi-check-lg"></i></span>
                            <strong>@option.OptionText</strong>
                        </label>
                    }
                </div>
                <div class="campaign-poll-meta">
                    <div class="campaign-voter-stack" aria-hidden="true"><span>SS</span><span>VK</span><span>AS</span></div>
                    <span><strong>@Model.TotalVotes</strong> total votes</span>
                    @if (Model.EndDate.HasValue) { <span class="campaign-poll-dot">•</span><span>@daysLeft days left</span> }
                    <button class="campaign-poll-submit" type="submit">Vote now <i class="bi bi-arrow-right"></i></button>
                </div>
            }
        </div>
    </section>
}
