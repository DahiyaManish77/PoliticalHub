@model IEnumerable<PoliticalLeaderPortal.ViewModels.HomeVideoGalleryVM>
@using System
@using System.Collections.Generic
@using System.Linq

@{
    Layout = null;
    var videos = Model == null
        ? new List<PoliticalLeaderPortal.ViewModels.HomeVideoGalleryVM>()
        : Model.Take(7).ToList();
}

@functions {
    private string GetYouTubeId(string url)
    {
        if (String.IsNullOrWhiteSpace(url)) return String.Empty;

        var value = url.Trim();

        if (value.Contains("watch?v="))
        {
            var id = value.Substring(value.IndexOf("watch?v=", StringComparison.Ordinal) + 8);
            var amp = id.IndexOf("&", StringComparison.Ordinal);
            return amp >= 0 ? id.Substring(0, amp) : id;
        }

        if (value.Contains("youtu.be/"))
        {
            var id = value.Substring(value.LastIndexOf("/", StringComparison.Ordinal) + 1);
            var query = id.IndexOf("?", StringComparison.Ordinal);
            return query >= 0 ? id.Substring(0, query) : id;
        }

        if (value.Contains("/shorts/"))
        {
            var id = value.Substring(value.IndexOf("/shorts/", StringComparison.Ordinal) + 8);
            var query = id.IndexOf("?", StringComparison.Ordinal);
            return query >= 0 ? id.Substring(0, query) : id;
        }

        return String.Empty;
    }

    private string GetVideoThumbnail(PoliticalLeaderPortal.ViewModels.HomeVideoGalleryVM item)
    {
        if (item == null)
        {
            return "~/Content/images/video-placeholder.jpg";
        }

        if (!String.IsNullOrWhiteSpace(item.ThumbnailImagePath))
        {
            return item.ThumbnailImagePath;
        }

        var youtubeId = GetYouTubeId(item.YoutubeUrl);

        return String.IsNullOrWhiteSpace(youtubeId)
            ? "~/Content/images/video-placeholder.jpg"
            : "https://img.youtube.com/vi/" + youtubeId + "/hqdefault.jpg";
    }

    private string GetVideoSource(PoliticalLeaderPortal.ViewModels.HomeVideoGalleryVM item)
    {
        if (item == null) return String.Empty;
        var youtubeId = GetYouTubeId(item.YoutubeUrl);
        if (!String.IsNullOrWhiteSpace(youtubeId))
        {
            return "https://www.youtube.com/embed/" + youtubeId + "?autoplay=1&rel=0";
        }
        return String.IsNullOrWhiteSpace(item.VideoFilePath) ? item.YoutubeUrl : item.VideoFilePath;
    }
}

<section class="campaign-showcase campaign-video-showcase" id="videos">
    <div class="campaign-showcase-head">
        <div>
            <span class="campaign-kicker">WATCH</span>
            <h2>Latest broadcasts</h2>
            <p>Speeches, interviews and important updates from the constituency.</p>
        </div>
        <a class="campaign-explore" href="@Url.Action("Index", "Video")">
            Explore videos <i class="bi bi-arrow-up-right"></i>
        </a>
    </div>
    <div class="campaign-video-curve @(videos.Count > 10 ? "is-overflowing" : "is-centered")"
         data-showcase-track
         data-auto-scroll="true">
        <div class="campaign-video-track">
            @if (videos.Any())
            {
                foreach (var item in videos)
                {
                    var thumbnail = GetVideoThumbnail(item);
                    var imageUrl = thumbnail.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                        ? thumbnail
                        : Url.Content(thumbnail);
                    var videoSource = GetVideoSource(item);

                    <button type="button"
                       class="campaign-video-tile js-campaign-video"
                       data-video-id="@item.VideoId"
                       data-video-src="@videoSource"
                       data-video-title="@item.VideoTitle"
                       aria-label="Watch @item.VideoTitle">
                        <img src="@imageUrl"
                             alt="@(String.IsNullOrWhiteSpace(item.VideoTitle) ? "Latest broadcast" : item.VideoTitle)" />

                        <span class="campaign-video-play" aria-hidden="true">
                            <i class="bi bi-play-fill"></i>
                        </span>

                        <div class="campaign-video-caption">
                            @(String.IsNullOrWhiteSpace(item.VideoTitle)
                                ? "Latest broadcast"
                                : item.VideoTitle)
                        </div>
                    </button>
                }
            }
            else
            {
                for (var i = 1; i <= 5; i++)
                {
                    <article class="campaign-video-tile campaign-placeholder">
                        <span class="campaign-video-play" aria-hidden="true">
                            <i class="bi bi-play-fill"></i>
                        </span>
                        <div class="campaign-video-caption">Latest broadcast</div>
                    </article>
                }
            }
        </div>
    </div>
</section>

<div class="campaign-video-modal" data-campaign-video-modal aria-hidden="true">
    <div class="campaign-video-backdrop" data-video-close></div>
    <div class="campaign-video-dialog" role="dialog" aria-modal="true" aria-labelledby="campaignVideoTitle">
        <button type="button" class="campaign-video-close" data-video-close aria-label="Close video">
            <i class="bi bi-x-lg"></i>
        </button>
        <div class="campaign-video-frame" data-video-frame></div>
        <div class="campaign-video-footer">
            <h3 id="campaignVideoTitle" data-video-modal-title>Latest broadcast</h3>
            <div class="campaign-video-actions"
                 data-public-actions
                 data-item-type="video"
                 data-item-id=""
                 data-title=""
                 data-url="">
                <button type="button" data-action="like"><i class="bi bi-heart"></i> Like <span data-like-count>0</span></button>
                <button type="button" data-action="share"><i class="bi bi-share"></i> Share</button>
            </div>
        </div>
    </div>
</div>
