@model List<PoliticalLeaderPortal.ViewModels.LatestNewsDisplayVM>
@using System.Linq

@{
    Layout = null;

    var news = Model ?? new List<PoliticalLeaderPortal.ViewModels.LatestNewsDisplayVM>();
    var magazineNews = news.Take(12).ToList();
}

<section class="editorial-newsroom-section">
    <div class="container">

        <!-- HEADER -->
        <header class="editorial-newsroom-header reveal-element">
            <div class="editorial-header-left">
                <h2 class="editorial-section-title">News &amp; Media</h2>
            </div>
            <div class="editorial-header-right">
                <a href="@Url.Action("Index","News")" class="editorial-view-all-btn">
                    Explore News <i class="bi bi-arrow-up-right"></i>
                </a>
            </div>
        </header>

        <div class="news-magazine reveal-element">
            <aside class="news-magazine-left">
                @for (var leftSlot = 0; leftSlot < 5; leftSlot++)
                {
                    var dataIndex = leftSlot + 1;
                    var item = dataIndex < magazineNews.Count ? magazineNews[dataIndex] : null;
                    var isImageStory = leftSlot == 2;
                    var title = item == null || String.IsNullOrWhiteSpace(item.Title) ? "Important constituency update coming soon" : item.Title;
                    var image = item != null && !String.IsNullOrWhiteSpace(item.ImagePath) ? Url.Content(item.ImagePath) : Url.Content("~/Content/images/leader.png");
                    <article class="news-magazine-side @(isImageStory ? "has-image" : "") @(item == null ? "is-placeholder" : "")">
                        @if (isImageStory) { <img src="@image" alt="@title" loading="lazy" /> }
                        <a href="@(item == null ? Url.Action("Index","News") : Url.Action("Details","News",new{id=item.NewsId}))">@title</a>
                        <div><span>By Campaign News Desk</span><time>@(item == null ? "Soon" : item.PublishDate.ToString("dd MMM"))</time></div>
                    </article>
                }
            </aside>

            <main class="news-magazine-center">
                @{
                    var feature = magazineNews.FirstOrDefault();
                    var featureTitle = feature == null || String.IsNullOrWhiteSpace(feature.Title) ? "Latest public engagement and constituency news" : feature.Title;
                    var featureImage = feature != null && !String.IsNullOrWhiteSpace(feature.ImagePath) ? Url.Content(feature.ImagePath) : Url.Content("~/Content/images/leader.png");
                }
                <article class="news-magazine-feature @(feature == null ? "is-placeholder" : "")">
                    <img src="@featureImage" alt="@featureTitle" loading="lazy" />
                    <div class="news-magazine-feature-copy">
                        <span>LATEST NEWS &amp; PUBLIC UPDATES</span>
                        <h3><a href="@(feature == null ? Url.Action("Index","News") : Url.Action("Details","News",new{id=feature.NewsId}))">@featureTitle</a></h3>
                        <p>@(feature == null || String.IsNullOrWhiteSpace(feature.ShortDescription) ? "Verified news, public meetings and important constituency announcements will appear in this featured space." : feature.ShortDescription)</p>
                        <div><span>By Campaign News Desk</span><time>@(feature == null ? "Awaiting publication" : feature.PublishDate.ToString("dd MMM yyyy"))</time></div>
                    </div>
                </article>
                <div class="news-magazine-lower">
                    @for (var lowerSlot = 6; lowerSlot < 9; lowerSlot++)
                    {
                        var item = lowerSlot < magazineNews.Count ? magazineNews[lowerSlot] : null;
                        var title = item == null || String.IsNullOrWhiteSpace(item.Title) ? "New community update will appear here" : item.Title;
                        var image = item != null && !String.IsNullOrWhiteSpace(item.ImagePath) ? Url.Content(item.ImagePath) : Url.Content("~/Content/images/people-say-upload-leader.png");
                        <article class="news-magazine-tile @(item == null ? "is-placeholder" : "")">
                            <img src="@image" alt="@title" loading="lazy" />
                            <a href="@(item == null ? Url.Action("Index","News") : Url.Action("Details","News",new{id=item.NewsId}))">@title</a>
                            <div><span>News Desk</span><time>@(item == null ? "Soon" : item.PublishDate.ToString("dd MMM"))</time></div>
                        </article>
                    }
                </div>
            </main>

            <aside class="news-magazine-right">
                @for (var rightSlot = 9; rightSlot < 12; rightSlot++)
                {
                    var item = rightSlot < magazineNews.Count ? magazineNews[rightSlot] : null;
                    var title = item == null || String.IsNullOrWhiteSpace(item.Title) ? "Upcoming campaign and constituency report" : item.Title;
                    var image = item != null && !String.IsNullOrWhiteSpace(item.ImagePath) ? Url.Content(item.ImagePath) : Url.Content("~/Content/images/people-say-upload-leader.png");
                    <article class="news-magazine-tile @(item == null ? "is-placeholder" : "")">
                        <img src="@image" alt="@title" loading="lazy" />
                        <a href="@(item == null ? Url.Action("Index","News") : Url.Action("Details","News",new{id=item.NewsId}))">@title</a>
                        <div><span>Campaign Desk</span><time>@(item == null ? "Soon" : item.PublishDate.ToString("dd MMM"))</time></div>
                    </article>
                }
            </aside>
        </div>
    </div>
</section>
