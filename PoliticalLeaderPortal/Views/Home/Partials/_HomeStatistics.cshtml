@model List<PoliticalLeaderPortal.ViewModels.HomeStatisticDisplayVM>

@{
    Layout = null;
    var statistics = Model ?? new List<PoliticalLeaderPortal.ViewModels.HomeStatisticDisplayVM>();
}

<section class="home-statistics-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <span class="section-subtitle">Campaign Impact</span>
                <h2 class="section-title">Development, Outreach And Public Service At A Glance</h2>
                <p class="section-description">
                    Key numbers from public communication, field activity,
                    volunteer coordination and constituency engagement.
                </p>
            </div>
        </div>

        @if (!statistics.Any())
        {
            <div class="home-section-empty">
                <strong>Statistics will appear here</strong>
                <span>Add active home page statistics from Admin CMS to populate this section.</span>
            </div>
        }
        else
        {
            <div class="row g-3 mt-3">
                @foreach (var item in statistics)
                {
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="stat-card">
                            <div class="stat-icon">
                                <i class="@item.IconClass"></i>
                            </div>
                            <h3 class="counter" data-target="@item.StatisticValue">0</h3>
                            <h6>@item.Title</h6>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", function () {
    var counters = document.querySelectorAll(".counter");

    counters.forEach(function (counter) {
        var target = parseInt(counter.getAttribute("data-target"), 10);
        if (isNaN(target)) {
            counter.innerText = "0";
            return;
        }

        var count = 0;
        var increment = Math.max(1, Math.ceil(target / 80));
        var timer = setInterval(function () {
            count += increment;
            if (count >= target) {
                count = target;
                clearInterval(timer);
            }
            counter.innerText = count.toLocaleString();
        }, 18);
    });
});
</script>
