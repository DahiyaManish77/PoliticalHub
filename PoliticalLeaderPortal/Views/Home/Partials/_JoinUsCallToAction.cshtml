
@{
    Layout = null;
}

<section class="joinus-cta-section">

    <div class="container">

        <div class="joinus-cta-wrapper">

            <div class="row align-items-center">

                <div class="col-lg-8">

                    <span class="cta-badge">
                        Join The Mission
                    </span>

                    <h2 class="cta-title">
                        Together We Can Build A Stronger And More Developed Future
                    </h2>

                    <p class="cta-description">
                        Become a part of our mission for development,
                        public service and social welfare. Join thousands
                        of supporters working towards a better future for
                        every citizen.
                    </p>

                </div>

                <div class="col-lg-4">

                    <div class="cta-buttons">

                        <a href="@Url.Action("Volunteer", "CitizenConnect", new { area = "" })"
                           class="btn-join-now">
                            Join Us Now
                        </a>

                        <a href="@Url.Action("Volunteer", "CitizenConnect", new { area = "" })"
                           class="btn-volunteer">
                            Become Volunteer
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
