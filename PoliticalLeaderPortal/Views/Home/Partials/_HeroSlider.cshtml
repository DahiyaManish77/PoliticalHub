@model IEnumerable<PoliticalLeaderPortal.ViewModels.HeroSliderDisplayVM>
@using System.Linq
@if (Model != null && Model.Any())
{
    <section class="campaign-hero">
        <div class="swiper campaignHeroSwiper">
            <div class="swiper-wrapper">
                @foreach (var item in Model.OrderBy(x => x.DisplayOrder))
                {
                    var bg = !String.IsNullOrWhiteSpace(item.BackgroundImagePath) ? Url.Content(item.BackgroundImagePath) : (!String.IsNullOrWhiteSpace(item.ImagePath) ? Url.Content(item.ImagePath) : "");
                    <div class="swiper-slide campaign-hero-slide" style="background-image:url('@bg');">
                        <div class="campaign-hero-overlay"></div>
                        <div class="campaign-shell campaign-hero-content">
                            @if (!String.IsNullOrWhiteSpace(item.SubTitle)) { <div class="campaign-eyebrow">@item.SubTitle</div> }
                            <h1>@item.Title</h1>
                            @if (!String.IsNullOrWhiteSpace(item.Description)) { <p>@item.Description</p> }
                            <div class="campaign-hero-actions">
                                @if (!String.IsNullOrWhiteSpace(item.ButtonText)) { <a class="campaign-btn campaign-btn-gold" href="@item.ButtonUrl">@item.ButtonText</a> }
                                @if (!String.IsNullOrWhiteSpace(item.ButtonText2)) { <a class="campaign-btn campaign-btn-outline" href="@item.ButtonUrl2">@item.ButtonText2</a> }
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="campaign-hero-pagination swiper-pagination"></div>
        </div>
    </section>
}
