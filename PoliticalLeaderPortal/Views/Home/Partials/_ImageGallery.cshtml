@model List<PoliticalLeaderPortal.ViewModels.PublicGalleryImageVM>
@using System.Linq
@{
    Layout = null;
    var items = Model == null ? new List<PoliticalLeaderPortal.ViewModels.PublicGalleryImageVM>() : Model.Take(4).ToList();
}

<section class="campaign-showcase campaign-photo-showcase" id="gallery">
    <div class="campaign-showcase-head">
        <div>
            <span class="campaign-kicker">ON THE GROUND</span>
            <h2>Community in action</h2>
            <p>Moments from public meetings, constituency visits and community initiatives.</p>
        </div>
        <a class="campaign-explore" href="@Url.Action("Index", "Gallery")">Explore gallery <i class="bi bi-arrow-up-right"></i></a>
    </div>
    <div class="campaign-accordion-viewport campaign-curved-photo-strip is-centered"
         data-showcase-track data-auto-scroll="true">
        <div class="campaign-accordion-track">
            @for (var index = 0; index < items.Count; index++)
            {
                var item = items[index];
                var image = String.IsNullOrWhiteSpace(item.ImagePath) ? Url.Content("~/Content/images/gallery-placeholder.jpg") : Url.Content(item.ImagePath);
                var title = String.IsNullOrWhiteSpace(item.ImageTitle) ? "Community activity" : item.ImageTitle;
                <article class="campaign-accordion-item campaign-curved-photo @(index == 0 ? "is-first" : index == items.Count - 1 ? "is-last" : "") js-gallery-lightbox" role="button" tabindex="0"
                         data-image-id="@item.GalleryImageId" data-image-src="@image" data-image-title="@title"
                         aria-label="Open @title">
                    <img src="@image" alt="@title" loading="lazy" />
                    <div class="campaign-accordion-copy"><span>View story</span><strong>@title</strong></div>
                </article>
            }
        </div>
    </div>
</section>

<div class="gallery-lightbox campaign-gallery-lightbox" data-gallery-lightbox aria-hidden="true">
    <div class="gallery-lightbox-backdrop" data-gallery-close></div>
    <div class="gallery-lightbox-dialog" role="dialog" aria-modal="true" aria-labelledby="campaignGalleryTitle">
        <button type="button" class="gallery-lightbox-close" data-gallery-close aria-label="Close image"><i class="bi bi-x-lg"></i></button>
        <div class="gallery-lightbox-media"><img src="" alt="" data-gallery-lightbox-img /></div>
        <div class="gallery-lightbox-footer">
            <h3 id="campaignGalleryTitle" data-gallery-lightbox-title>Photo Gallery</h3>
            <div class="gallery-lightbox-actions" data-public-actions data-item-type="gallery" data-item-id="" data-title="" data-url="">
                <button type="button" data-action="like"><i class="bi bi-heart"></i> Like <span data-like-count>0</span></button>
                <button type="button" data-action="comment"><i class="bi bi-chat-dots"></i> Comment</button>
                <button type="button" data-action="share"><i class="bi bi-share"></i> Share</button>
                <a class="gallery-download-btn" href="#" download data-gallery-download><i class="bi bi-download"></i> Download</a>
            </div>
        </div>
    </div>
</div>
