@model PoliticalLeaderPortal.Areas.Admin.ViewModels.ElectionWarRoom.CampaignPollVM
@{
    ViewBag.Title = "Thank You";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body p-5">
                    <i class="bi bi-check-circle text-success display-4"></i>
                    <h2 class="fw-bold mt-3">Thank you for your feedback</h2>
                    <p class="text-muted">Your response has been recorded.</p>
                    @if (Model != null && Model.ShowPublicResults)
                    {
                        <div class="text-start mt-4">
                            @foreach (var option in Model.Options)
                            {
                                <div class="mb-3"><div class="d-flex justify-content-between"><strong>@option.OptionText</strong><span>@option.ResponsePercent%</span></div><div class="progress"><div class="progress-bar" style="width:@option.ResponsePercent%"></div></div></div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
