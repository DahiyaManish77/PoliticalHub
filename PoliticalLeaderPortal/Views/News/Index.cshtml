@model List<PoliticalLeaderPortal.ViewModels.LatestNewsDisplayVM>

@{
    ViewBag.Title = "Latest News";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<section class="py-5">

    <div class="container">

        <div class="row mb-5">

            <div class="col-lg-12 text-center">

                <span class="section-subtitle">
                    Latest Updates
                </span>

                <h2 class="section-title">
                    News & Announcements
                </h2>

                <p class="section-description">
                    Stay updated with recent activities,
                    public engagements and important
                    announcements.
                </p>

            </div>

        </div>

        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6">

                    <div class="card h-100 shadow-sm border-0">

                        @if (!string.IsNullOrWhiteSpace(
                            item.ImagePath))
                        {
                            <img src="@Url.Content(item.ImagePath)"
                                 class="card-img-top"
                                 alt="@item.Title"
                                 style="height:250px;
                                        object-fit:cover;" />
                        }

                        <div class="card-body">

                            <div class="mb-2 text-muted">

                                <i class="bi bi-calendar-event"></i>
                                @(item.PublishDate.ToString("dd MMM yyyy"))

                            </div>

                            @if (item.IsFeatured)
                            {
                                <span class="badge bg-danger mb-2">

                                    Featured

                                </span>
                            }

                            <h5 class="card-title">

                                @item.Title

                            </h5>

                            <p class="card-text">

                                @item.ShortDescription

                            </p>

                        </div>

                        <div class="card-footer bg-white border-0">

                            <a href="@Url.Action(
                                "Details",
                                "News",
                                new
                                {
                                    id = item.NewsId
                                })"
                               class="btn btn-primary w-100">

                                Read More

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

</section>