@model IEnumerable<PoliticalLeaderPortal.ViewModels.VideoGalleryListVM>

@{
    ViewBag.Title = "Video Gallery";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    var videos = Model == null ? new List<PoliticalLeaderPortal.ViewModels.VideoGalleryListVM>() : Model.ToList();
    var featuredVideo = videos.FirstOrDefault(x => x.IsFeatured) ?? videos.FirstOrDefault();
}

@functions
{
    private string GetYouTubeId(string url)
    {
        if (String.IsNullOrWhiteSpace(url)) return "";
        var value = url.Trim();
        if (value.Contains("watch?v="))
        {
            var id = value.Substring(value.IndexOf("watch?v=") + 8);
            var amp = id.IndexOf("&");
            return amp >= 0 ? id.Substring(0, amp) : id;
        }
        if (value.Contains("youtu.be/"))
        {
            var id = value.Substring(value.LastIndexOf("/") + 1);
            var query = id.IndexOf("?");
            return query >= 0 ? id.Substring(0, query) : id;
        }
        if (value.Contains("/shorts/"))
        {
            var id = value.Substring(value.IndexOf("/shorts/") + 8);
            var query = id.IndexOf("?");
            return query >= 0 ? id.Substring(0, query) : id;
        }
        return "";
    }

    private string GetThumbnail(PoliticalLeaderPortal.ViewModels.VideoGalleryListVM item)
    {
        if (item == null) return "/Content/images/logo.png";
        if (!String.IsNullOrWhiteSpace(item.ThumbnailImagePath)) return item.ThumbnailImagePath;
        var youtubeId = GetYouTubeId(item.YoutubeUrl);
        return String.IsNullOrWhiteSpace(youtubeId) ? "/Content/images/logo.png" : "https://img.youtube.com/vi/" + youtubeId + "/hqdefault.jpg";
    }
}

<section class="video-index">
    <div class="container">
        <div class="video-index-head">
            <span>Video Gallery</span>
            <h1>Speeches, Meetings & Public Activities</h1>
            <p>Watch public meetings, development activities, social programs, interviews and important events.</p>
        </div>

        @if (featuredVideo != null)
        {
            <article class="video-feature-panel">
                <a href="@Url.Action("Details", "Video", new { id = featuredVideo.VideoId })" class="video-feature-media">
                    <img src="@Url.Content(GetThumbnail(featuredVideo))" alt="@featuredVideo.VideoTitle" />
                    <span><i class="bi bi-play-fill"></i></span>
                </a>
                <div class="video-feature-body">
                    <span class="video-chip">Featured Video</span>
                    <h2>@featuredVideo.VideoTitle</h2>
                    <p>@featuredVideo.CategoryName</p>
                    <a href="@Url.Action("Details", "Video", new { id = featuredVideo.VideoId })" class="video-primary-link">Watch Now</a>
                </div>
            </article>
        }

        <div class="video-grid">
            @if (videos.Any())
            {
                foreach (var video in videos)
                {
                    <article class="video-tile">
                        <a href="@Url.Action("Details", "Video", new { id = video.VideoId })" class="video-tile-media">
                            <img src="@Url.Content(GetThumbnail(video))" alt="@video.VideoTitle" />
                            <span><i class="bi bi-play-fill"></i></span>
                        </a>
                        <div class="video-tile-body">
                            <small>@video.CategoryName</small>
                            <h3>@video.VideoTitle</h3>
                            <a href="@Url.Action("Details", "Video", new { id = video.VideoId })">Watch Video</a>
                        </div>
                    </article>
                }
            }
            else
            {
                <div class="video-empty">No videos available.</div>
            }
        </div>
    </div>
</section>

<style>
    .video-index { background: #f6f8fb; padding: 42px 0; }
    .video-index-head { max-width: 820px; margin: 0 auto 24px; text-align: center; }
    .video-index-head span, .video-chip { display: inline-flex; color: #e85d04; background: #fff3e7; border-radius: 999px; padding: 5px 10px; font-size: .76rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0; }
    .video-index-head h1 { margin: 10px 0 8px; color: #111827; font-size: clamp(1.6rem, 3vw, 2.5rem); line-height: 1.1; font-weight: 850; }
    .video-index-head p { margin: 0; color: #64748b; font-size: .98rem; }
    .video-feature-panel { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(280px, .85fr); gap: 0; background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden; box-shadow: 0 14px 32px rgba(15, 23, 42, .07); margin-bottom: 22px; }
    .video-feature-media, .video-tile-media { position: relative; display: block; aspect-ratio: 16 / 9; background: #111827; overflow: hidden; }
    .video-feature-media img, .video-tile-media img { width: 100%; height: 100%; object-fit: cover; transition: transform .25s ease; }
    .video-feature-panel:hover img, .video-tile:hover img { transform: scale(1.035); }
    .video-feature-media span, .video-tile-media span { position: absolute; inset: 0; margin: auto; width: 58px; height: 58px; border-radius: 50%; background: #e85d04; color: #fff; display: grid; place-items: center; font-size: 1.6rem; box-shadow: 0 14px 26px rgba(232, 93, 4, .3); }
    .video-feature-body { padding: 24px; align-self: center; }
    .video-feature-body h2 { margin: 12px 0 8px; color: #111827; font-size: clamp(1.3rem, 2vw, 2rem); line-height: 1.18; font-weight: 850; }
    .video-feature-body p { color: #64748b; margin-bottom: 18px; }
    .video-primary-link, .video-tile-body a { display: inline-flex; align-items: center; justify-content: center; border-radius: 6px; background: #111827; color: #fff; padding: 9px 14px; text-decoration: none; font-weight: 750; font-size: .88rem; }
    .video-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
    .video-tile { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden; box-shadow: 0 10px 24px rgba(15, 23, 42, .055); }
    .video-tile-media span { width: 44px; height: 44px; font-size: 1.15rem; }
    .video-tile-body { padding: 13px; }
    .video-tile-body small { color: #e85d04; font-weight: 800; }
    .video-tile-body h3 { margin: 5px 0 12px; color: #111827; font-size: 1rem; line-height: 1.35; font-weight: 800; min-height: 44px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .video-empty { grid-column: 1 / -1; background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 32px; text-align: center; color: #64748b; }
    @@media (max-width: 991px) { .video-feature-panel, .video-grid { grid-template-columns: 1fr 1fr; } .video-feature-panel { display: block; } }
    @@media (max-width: 575px) { .video-index { padding: 30px 0; } .video-grid { grid-template-columns: 1fr; } }
</style>
